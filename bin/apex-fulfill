#!/usr/bin/env python3
"""
🏛️ APEX TERMINAL OS — COMMERCIAL LICENSE GENERATOR & PACKAGE FULFILLMENT CLI
Engineered exclusively for Rick Jefferson | RJ Business Solutions
Automatically adapts to custom White-Label branding & custom Stripe Payment Links
when ~/.apex-workspace/whitelabel.json is configured via `apex-whitelabel`.
"""

import hashlib
import json
import sys
import time
from pathlib import Path

WL_PATH = Path.home() / ".apex-workspace" / "whitelabel.json"


def load_brand_config() -> dict:
    cfg = {
        "company": "RJ Business Solutions",
        "key_prefix": "RJ",
        "delivery_url": "https://rjbizsolution23-wq.github.io/apex-terminal-os/",
        "price_dev": 197,
        "price_pro": 497,
        "price_ent": 1997,
        "stripe_link_dev": "https://buy.stripe.com/7sY7sDbCI0fb49N8j7eEq35",
        "stripe_link_pro": "https://buy.stripe.com/fZu4gr0Y42nj21FdDreEq36",
        "stripe_link_ent": "https://buy.stripe.com/28E8wHeOU0fbdKnczneEq37",
    }
    if WL_PATH.exists():
        try:
            cfg.update(json.loads(WL_PATH.read_text(encoding="utf-8")))
        except Exception:
            pass
    return cfg


def generate_license_key(prefix: str, email: str) -> str:
    clean_email = email.strip().lower()
    digest = hashlib.sha256(f"RJBS-APEX-2026:{prefix}:{clean_email}".encode("utf-8")).hexdigest().upper()
    block1 = digest[:4]
    block2 = digest[4:8]
    chk = sum(ord(c) for c in block1) % 97
    return f"{prefix}-{block1}-{block2}-{chk:02d}X9"


def main() -> None:
    cfg = load_brand_config()
    pfx = cfg.get("key_prefix", "RJ").upper()
    tiers = {
        "1": ("developer", "Developer Edition (Solo Operator)", f"${cfg['price_dev']}", f"{pfx}-DEV", "packages/apex-terminal-os-developer-v2.0.zip", cfg["stripe_link_dev"]),
        "developer": ("developer", "Developer Edition (Solo Operator)", f"${cfg['price_dev']}", f"{pfx}-DEV", "packages/apex-terminal-os-developer-v2.0.zip", cfg["stripe_link_dev"]),
        "dev": ("developer", "Developer Edition (Solo Operator)", f"${cfg['price_dev']}", f"{pfx}-DEV", "packages/apex-terminal-os-developer-v2.0.zip", cfg["stripe_link_dev"]),
        "2": ("sovereign", "Sovereign Full-Spectrum Suite (Pro)", f"${cfg['price_pro']}", f"{pfx}-SOV", "packages/apex-terminal-os-sovereign-pro-v2.0.zip", cfg["stripe_link_pro"]),
        "sovereign": ("sovereign", "Sovereign Full-Spectrum Suite (Pro)", f"${cfg['price_pro']}", f"{pfx}-SOV", "packages/apex-terminal-os-sovereign-pro-v2.0.zip", cfg["stripe_link_pro"]),
        "pro": ("sovereign", "Sovereign Full-Spectrum Suite (Pro)", f"${cfg['price_pro']}", f"{pfx}-SOV", "packages/apex-terminal-os-sovereign-pro-v2.0.zip", cfg["stripe_link_pro"]),
        "3": ("enterprise", "Enterprise Agency Fleet & White-Label", f"${cfg['price_ent']}", f"{pfx}-ENT", "packages/apex-terminal-os-enterprise-whitelabel-v2.0.zip", cfg["stripe_link_ent"]),
        "enterprise": ("enterprise", "Enterprise Agency Fleet & White-Label", f"${cfg['price_ent']}", f"{pfx}-ENT", "packages/apex-terminal-os-enterprise-whitelabel-v2.0.zip", cfg["stripe_link_ent"]),
        "ent": ("enterprise", "Enterprise Agency Fleet & White-Label", f"${cfg['price_ent']}", f"{pfx}-ENT", "packages/apex-terminal-os-enterprise-whitelabel-v2.0.zip", cfg["stripe_link_ent"]),
    }

    if len(sys.argv) < 2 or sys.argv[1] in ("-h", "--help"):
        print(f"""\033[1;36m🏛️ {cfg['company'].upper()} — LICENSE & PACKAGE FULFILLMENT ENGINE\033[0m
Usage:
  apex-fulfill <tier: dev|pro|ent> [customer_email]

Examples:
  apex-fulfill dev buyer@gmail.com       -> Generates ${cfg['price_dev']} Developer License + Package Link
  apex-fulfill pro founder@agency.io     -> Generates ${cfg['price_pro']} Sovereign Pro License + Package Link
  apex-fulfill ent cto@enterprise.com    -> Generates ${cfg['price_ent']} Enterprise White-Label License + Package Link
""")
        sys.exit(0)

    tier_arg = sys.argv[1].lower().strip()
    if tier_arg not in tiers:
        print(f"Unknown tier '{tier_arg}'. Choose: dev (${cfg['price_dev']}), pro (${cfg['price_pro']}), or ent (${cfg['price_ent']})")
        sys.exit(1)

    email = sys.argv[2] if len(sys.argv) > 2 else f"client-{int(time.time())}@rjbusinesssolutions.org"
    slug, name, price, prefix, pkg_rel, stripe_url = tiers[tier_arg]
    license_key = generate_license_key(prefix, email)
    base_url = cfg["delivery_url"].rstrip("/") + "/"
    auto_unlock_url = f"{base_url}?paid_tier={slug}&unlock={license_key}"

    print(f"""\033[1;36m==========================================================================\033[0m
\033[1;32m✓ COMMERCIAL LICENSE GENERATED — {cfg['company'].upper()}\033[0m
\033[1;36m==========================================================================\033[0m
  👤 Customer:      {email}
  📦 Package Tier:  \033[1;33m{name} ({price})\033[0m
  💳 Stripe Link:   \033[1;36m{stripe_url}\033[0m
  🔑 License Key:   \033[1;32m{license_key}\033[0m
  🚀 Auto-Delivery: \033[1;32m{auto_unlock_url}\033[0m
  🌐 Web Download:  {base_url}{pkg_rel}
  ⚡ CLI Installer: ./install/setup.sh --tier={slug} --key={license_key}
\033[1;36m==========================================================================\033[0m""")


if __name__ == "__main__":
    main()
