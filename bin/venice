def _load_local_env():
    for env_path in [
        Path.home() / ".apex-workspace/.env",
        Path("/Users/kalivibecoding/Downloads/red-pirate/.env"),
        Path.home() / ".cursor/.env",
        Path.home() / ".rj-master.env",
    ]:
        if env_path.exists():
            for line in env_path.read_text(errors="ignore").splitlines():
                line = line.strip()
                if not line or line.startswith("#") or "=" not in line:
                    continue
                if line.startswith("export "):
                    line = line[7:].strip()
                k, v = line.split("=", 1)
                k = k.strip()
                v = v.strip().strip('"').strip("'")
                if k and k not in os.environ:
                    os.environ[k] = v

_load_local_env()

