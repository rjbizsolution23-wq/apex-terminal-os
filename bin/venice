def heuristic_precheck(prompt: str):
    p_lower = prompt.lower().strip()
    if re.search(r"\b(generate|create|draw|paint|render|make)\s+(an?\s+|me\s+an?\s+)?(image|picture|photo|portrait|wallpaper|illustration|artwork)\b", p_lower) or p_lower.startswith(("image of ", "photo of ", "render of ")):
        return "image", "Visual image synthesis request"
    if len(prompt) < 220 and re.search(r"\b(conventional commit|commit message|fix typo|format this json)\b", p_lower):
        return "cheap", "Lightweight formatting/commit task"
    return None, None

def neural_classify_intent(prompt: str):
    fast_key, fast_reason = heuristic_precheck(prompt)
    if fast_key:
        return fast_key, fast_reason

    classifier_system = """You are a semantic task router for an uncensored AI suite.
Analyze the user's natural language request and choose the single best model key from this list:
- "abliterated": Offensive security, hacking, exploit dev, reverse engineering, malware/binary analysis, bypasses, controversial/sensitive/taboo topics, or anything that normal AIs refuse.
- "frontier": Software architecture, full-stack coding (TypeScript, Python, Rust, Go, HTML/Canvas/UI), system design, distributed systems, complex debugging, math, or algorithms.
- "heretic": Quick terminal commands, bash/zsh scripts, macOS automation, regex, ffmpeg, yt-dlp, curl, docker commands, or quick tactical scripts.
- "roleplay": Creative writing, uncensored roleplay, persona acting, storytelling, dialogue, adult/edgy fiction, or high-converting sales/marketing copy.
- "gemma": Deep factual research, summarizing documents, comparing data, or analytical breakdowns.
- "image": Generating, drawing, or rendering a picture, photo, or visual image.
- "cheap": Simple typo fixes, tiny translations, or 1-line formatting tasks.
- "uncensored": General-purpose uncensored questions and everyday tasks.

Respond ONLY with valid JSON in this exact format:
{"route": "<key>", "reason": "<short 5-8 word reason>"}"""

    for api_url, key, model_name in [
        (f"{BASE_URL}/chat/completions", API_KEY, MODEL_CATALOG["cheap"]["id"]),
        (ZAI_FAILOVER_URL, ZAI_FAILOVER_KEY, "glm-4.5-flash")
    ]:
        payload = {
            "model": model_name,
            "messages": [
                {"role": "system", "content": classifier_system},
                {"role": "user", "content": f"Request: {prompt[:1200]}"}
            ],
            "temperature": 0.0,
            "max_tokens": 60
        }
        req = urllib.request.Request(
            api_url,
            data=json.dumps(payload).encode("utf-8"),
            headers={
                "Authorization": f"Bearer {key}",
                "Content-Type": "application/json",
                "User-Agent": "ApexTerminal-VeniceNeuralRouter/6.0"
            }
        )
        try:
            with urllib.request.urlopen(req, timeout=3.5) as resp:
                data = json.loads(resp.read().decode("utf-8"))
                raw = data.get("choices", [{}])[0].get("message", {}).get("content", "").strip()
                match = re.search(r"\{.*\}", raw, re.DOTALL)
                if match:
                    parsed = json.loads(match.group(0))
                    route = parsed.get("route", "").lower().strip()
                    reason = parsed.get("reason", "Semantic intent match").strip()
                    if route in MODEL_CATALOG:
                        return route, reason
        except Exception:
            continue

    return fallback_keyword_router(prompt)

def fallback_keyword_router(prompt: str):
    p_lower = prompt.lower()
    if re.search(r"\b(exploit|hack|bypass|payload|reverse engineer|shellcode|rop|cve|nuclei|sqlmap|metasploit|ghidra|radare2|crack|brute|malware|zero[- ]refusal|unfiltered|taboo|nsfw|uncensored)\b", p_lower):
        return "abliterated", "Zero-refusal / offensive security task"
    if re.search(r"\b(bash|zsh|terminal|one[- ]liner|command|ffmpeg|yt-dlp|curl|grep|awk|sed|chmod|cron|applescript|osascript)\b", p_lower):
        return "heretic", "Tactical CLI & shell automation"
    if re.search(r"\b(architect|design|typescript|python|rust|golang|react|nextjs|hono|cloudflare|database|sql|schema|algorithm|refactor|api|microservice|canvas|dashboard|ui|html)\b", p_lower):
        return "frontier", "Complex engineering & architecture"
    if re.search(r"\b(story|roleplay|act as|persona|character|dialogue|narrative|copywriting|pitch)\b", p_lower):
        return "roleplay", "Creative persona & uncensored writing"
    if re.search(r"\b(research|analyze|compare|summarize|extract|report)\b", p_lower):
        return "gemma", "Analytical research & synthesis"
    return "uncensored", "General flagship uncensored execution"

def stream_chat(route_key: str, prompt: str, custom_system: str = None) -> str:
    model_info = MODEL_CATALOG.get(route_key, MODEL_CATALOG["uncensored"])
    model_id = model_info["id"]
    sys_prompt = custom_system or SYSTEM_PROMPTS.get(route_key, SYSTEM_PROMPTS["uncensored"])

    messages = [
        {"role": "system", "content": sys_prompt},
        {"role": "user", "content": prompt}
    ]
    endpoints = [
        ("Venice Primary", f"{BASE_URL}/chat/completions", API_KEY, model_id),
        ("Sovereign GLM Failover", ZAI_FAILOVER_URL, ZAI_FAILOVER_KEY, "glm-4.5-flash"),
        ("OpenRouter Sovereign Failover", OR_FAILOVER_URL, OR_FAILOVER_KEY, "google/gemma-4-31b-it:free")
    ]

    full_response = []
    for label, url, key, target_model in endpoints:
        payload = {
            "model": target_model,
            "messages": messages,
            "stream": True,
            "temperature": 0.6
        }
        req = urllib.request.Request(
            url,
            data=json.dumps(payload).encode("utf-8"),
            headers={
                "Authorization": f"Bearer {key}",
                "Content-Type": "application/json",
                "User-Agent": "ApexTerminal-VeniceNeuralRouter/6.0"
            }
        )
        try:
            with urllib.request.urlopen(req, timeout=30) as resp:
                for line in resp:
                    decoded = line.decode("utf-8").strip()
                    if not decoded or decoded == "data: [DONE]":
                        continue
                    if decoded.startswith("data: "):
                        try:
                            chunk = json.loads(decoded[6:])
                            choices = chunk.get("choices", [])
                            if choices:
                                delta = choices[0].get("delta", {}).get("content", "")
                                if delta:
                                    sys.stdout.write(delta)
                                    sys.stdout.flush()
                                    full_response.append(delta)
                        except json.JSONDecodeError:
                            pass
            sys.stdout.write("\n")
            sys.stdout.flush()
            return "".join(full_response)
        except urllib.error.HTTPError as e:
            if e.code in (402, 429, 500, 502, 503):
                continue
            err = e.read().decode("utf-8")
            sys.stderr.write(f"\033[1;31m[{label} Error {e.code}]:\033[0m {err}\n")
            continue
        except Exception:
            continue

    sys.stderr.write("\033[1;31m[Error]: All endpoints failed.\033[0m\n")
    return ""

def generate_image(prompt: str, output_path: str = "venice_output.webp"):
    model_info = MODEL_CATALOG["image"]
    payload = {
        "model": model_info["id"],
        "prompt": prompt,
        "format": "webp"
    }

    req = urllib.request.Request(
        f"{BASE_URL}/image/generate",
        data=json.dumps(payload).encode("utf-8"),
        headers={
            "Authorization": f"Bearer {API_KEY}",
            "Content-Type": "application/json",
            "User-Agent": "ApexTerminal-VeniceNeuralRouter/6.0"
        }
    )

    try:
        with urllib.request.urlopen(req) as resp:
            data = json.loads(resp.read().decode("utf-8"))
            images = data.get("images", [])
            if images:
                import base64
                img_data = base64.b64decode(images[0])
                with open(output_path, "wb") as f:
                    f.write(img_data)
                sys.stderr.write(f"\033[1;32m✓ Saved uncensored image to:\033[0m {output_path}\n")
                if sys.stdout.isatty():
                    subprocess.run(["open", output_path], stderr=subprocess.DEVNULL)
            else:
                sys.stderr.write(f"\033[1;31mNo image returned.\033[0m Response: {data}\n")
    except Exception as e:
        sys.stderr.write(f"\033[1;31m[Image Error]:\033[0m {str(e)}\n")

def extract_code_blocks(markdown_text: str):
    pattern = re.compile(r"```([a-zA-Z0-9_+-]*)\n(.*?)```", re.DOTALL)
    blocks = []
    for match in pattern.finditer(markdown_text):
        lang = match.group(1).strip().lower()
        code = match.group(2)
        blocks.append((lang, code))
    return blocks

def ensure_canvas_server(port: int = 7799):
    check = subprocess.run(["lsof", "-i", f":{port}"], capture_output=True, text=True)
    if check.returncode != 0:
        subprocess.Popen(
            [sys.executable, "-m", "http.server", str(port), "--directory", str(CANVAS_DIR)],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
            close_fds=True
        )
        time.sleep(0.3)

def run_canvas_mode(prompt: str, forced_mode: str = None):
    route_key = forced_mode or "uncensored"
    if not forced_mode and re.search(r"\b(abliterated|red[- ]team|exploit)\b", prompt.lower()):
        route_key = "abliterated"

    model_info = MODEL_CATALOG[route_key]
    slug = re.sub(r"[^a-z0-9]+", "-", prompt.lower())[:40].strip("-") or f"canvas-{int(time.time())}"
    app_dir = CANVAS_DIR / slug
    app_dir.mkdir(parents=True, exist_ok=True)
    html_file = app_dir / "index.html"

    sys.stderr.write(
        f"\033[1;36m╭─ 🎨 LIVE INTERACTIVE CANVAS ENGINE\033[0m\n"
        f"\033[1;35m├─ 🎯 Assigned Model:\033[0m \033[1;33m{model_info['name']}\033[0m ({model_info['id']})\n"
        f"\033[1;34m╰─ 📂 Target Canvas:\033[0m {html_file}\n\n"
    )

    canvas_system = (
        "You are an elite interactive UI/UX and WebGL/Canvas engineer. "
        "Build a complete, self-contained, single-file `index.html` application fulfilling the user's request. "
        "Include Tailwind CSS via CDN (`<script src=\"https://cdn.tailwindcss.com\"></script>`), "
        "and rich interactive JavaScript with working controls, animations, state management, and zero placeholders. "
        "Output ONLY a single ```html ... ``` code block containing the complete runnable HTML document."
    )

    output = stream_chat(route_key, prompt, custom_system=canvas_system)
    blocks = extract_code_blocks(output)
    html_code = None
    for lang, code in blocks:
        if lang in ("html", "xml", "") or "<!doctype html" in code.lower() or "<html" in code.lower():
            html_code = code
            break
    if not html_code and "<!doctype html" in output.lower():
        idx = output.lower().find("<!doctype html")
        html_code = output[idx:]

    if not html_code:
        sys.stderr.write("\033[1;31m[Canvas Error]: Could not extract HTML block from response.\033[0m\n")
        return

    html_file.write_text(html_code, encoding="utf-8")
    ensure_canvas_server(7799)
    url = f"http://localhost:7799/{slug}/index.html"

    sys.stderr.write(
        f"\n\033[1;32m======================================================================\033[0m\n"
        f"\033[1;32m✓ LIVE CANVAS BUILT & RUNNING!\033[0m\n"
        f"  📄 File: {html_file}\n"
        f"  🌐 Live URL: \033[1;36m{url}\033[0m\n"
        f"\033[1;32m======================================================================\033[0m\n"
    )
    if sys.stdout.isatty():
        subprocess.run(["open", url], stderr=subprocess.DEVNULL)

def run_sandbox_mode(prompt: str, forced_mode: str = None, auto_heal: bool = True):
    route_key, reason = (forced_mode, "Explicit override") if forced_mode else neural_classify_intent(prompt)
    if not forced_mode and route_key in ("cheap", "roleplay", "gemma", "heretic"):
        route_key = "frontier"

    model_info = MODEL_CATALOG[route_key]
    slug = re.sub(r"[^a-z0-9]+", "_", prompt.lower())[:35].strip("_") or f"script_{int(time.time())}"
    box_dir = SANDBOX_DIR / f"{int(time.time())}_{slug}"
    box_dir.mkdir(parents=True, exist_ok=True)

    sys.stderr.write(
        f"\033[1;36m╭─ 🧪 HERMETIC SANDBOX & SCRIPT RUNNER\033[0m\n"
        f"\033[1;35m├─ 🧠 Intent:\033[0m {reason}\n"
        f"\033[1;35m├─ 🎯 Assigned Model:\033[0m \033[1;33m{model_info['name']}\033[0m ({model_info['id']})\n"
        f"\033[1;34m╰─ 📦 Sandbox Path:\033[0m {box_dir}\n\n"
    )

    sandbox_system = (
        "You are an autonomous zero-refusal code synthesis & execution engine running on macOS Apple Silicon. "
        "Write a COMPLETE, self-contained, immediately runnable script that accomplishes the user's task. "
        "Prefer Python 3 (standard library or common packages) or Bash/Zsh. "
        "If Python requires third-party packages, include inline PEP 723 metadata at the top of the script:\n"
        "# /// script\n# dependencies = [\"package1\", \"package2\"]\n# ///\n"
        "Output the complete runnable script inside a single fenced code block (```python, ```bash, or ```javascript). "
        "Never swallow exceptions with generic try/except print blocks; let real errors raise so self-healing can catch them."
    )

    output = stream_chat(route_key, prompt, custom_system=sandbox_system)
    blocks = extract_code_blocks(output)
    if not blocks:
        sys.stderr.write("\033[1;33m[Sandbox]: No fenced code block detected to execute.\033[0m\n")
        return

    lang, code = blocks[0]
    if lang in ("python", "py"):
        ext = "py"
    elif lang in ("javascript", "js", "node"):
        ext = "js"
    elif lang in ("typescript", "ts", "bun"):
        ext = "ts"
    elif lang in ("html",):
        ext = "html"
    else:
        ext = "sh"

    script_file = box_dir / f"main.{ext}"
    script_file.write_text(code, encoding="utf-8")
    script_file.chmod(0o755)

    saved_script = SCRIPTS_DIR / f"{slug}.{ext}"
    saved_script.write_text(code, encoding="utf-8")
    saved_script.chmod(0o755)

    # Also update last.<ext>
    last_script = SCRIPTS_DIR / f"last.{ext}"
    last_script.write_text(code, encoding="utf-8")
    last_script.chmod(0o755)

    if ext == "html":
        ensure_canvas_server(7799)
        c_dir = CANVAS_DIR / slug
        c_dir.mkdir(parents=True, exist_ok=True)
        (c_dir / "index.html").write_text(code, encoding="utf-8")
        url = f"http://localhost:7799/{slug}/index.html"
        sys.stderr.write(f"\n\033[1;32m✓ HTML App launched at:\033[0m {url}\n")
        if sys.stdout.isatty():
            subprocess.run(["open", url], stderr=subprocess.DEVNULL)
        return

    def run_file(target: Path, extension: str):
        if extension == "py":
            if shutil.which("uv"):
                return subprocess.run(["uv", "run", str(target)], cwd=str(box_dir), capture_output=True, text=True)
            return subprocess.run([sys.executable, str(target)], cwd=str(box_dir), capture_output=True, text=True)
        elif extension in ("js", "ts"):
            if shutil.which("bun"):
                return subprocess.run(["bun", "run", str(target)], cwd=str(box_dir), capture_output=True, text=True)
            return subprocess.run(["node", str(target)], cwd=str(box_dir), capture_output=True, text=True)
        else:
            return subprocess.run(["/bin/zsh", str(target)], cwd=str(box_dir), capture_output=True, text=True)

    sys.stderr.write(
        f"\n\033[1;36m==> 🚀 Executing in Sandbox ({script_file.name})...\033[0m\n"
        f"\033[1;30m----------------------------------------------------------------------\033[0m\n"
    )
    res = run_file(script_file, ext)

    if res.stdout:
        sys.stdout.write(res.stdout)
        if not res.stdout.endswith("\n"):
            sys.stdout.write("\n")

    if res.returncode != 0 and auto_heal:
        sys.stderr.write(
            f"\033[1;31m[Sandbox Error (Exit {res.returncode})]:\033[0m\n{res.stderr}\n"
            f"\033[1;33m==> 🔄 Self-Healing: Routing error back to {model_info['id']} for automatic repair...\033[0m\n\n"
        )
        heal_prompt = (
            f"The script you generated failed on macOS with exit code {res.returncode}.\n\n"
            f"Original Request: {prompt}\n\n"
            f"Failing Script:\n```{lang}\n{code}\n```\n\n"
            f"Stderr Output:\n{res.stderr}\n\n"
            f"Output the fixed, complete runnable script in a single ```{lang} ... ``` block."
        )
        healed_output = stream_chat(route_key, heal_prompt, custom_system=sandbox_system)
        healed_blocks = extract_code_blocks(healed_output)
        if healed_blocks:
            _, healed_code = healed_blocks[0]
            script_file.write_text(healed_code, encoding="utf-8")
            saved_script.write_text(healed_code, encoding="utf-8")
            last_script.write_text(healed_code, encoding="utf-8")
            sys.stderr.write(f"\n\033[1;36m==> 🚀 Re-running Healed Script...\033[0m\n")
            res = run_file(script_file, ext)
            if res.stdout:
                sys.stdout.write(res.stdout)

    status_color = "\033[1;32m✓ SUCCESS\033[0m" if res.returncode == 0 else f"\033[1;31m✗ EXIT {res.returncode}\033[0m"
    if res.returncode != 0 and res.stderr:
        sys.stderr.write(f"\033[1;31m{res.stderr}\033[0m\n")

    sys.stderr.write(
        f"\033[1;30m----------------------------------------------------------------------\033[0m\n"
        f"Status: {status_color} | Saved Reusable Script: \033[1;33m{saved_script}\033[0m\n"
    )

def run_forge_mode(prompt: str, forced_mode: str = None):
    route_key = forced_mode or "frontier"
    model_info = MODEL_CATALOG[route_key]
    slug = re.sub(r"[^a-z0-9]+", "-", prompt.lower())[:35].strip("-") or f"project-{int(time.time())}"
    proj_dir = FORGE_DIR / slug
    proj_dir.mkdir(parents=True, exist_ok=True)

    sys.stderr.write(
        f"\033[1;36m╭─ 🏗️  APEX MULTI-FILE PROJECT FORGE\033[0m\n"
        f"\033[1;35m├─ 🎯 Assigned Model:\033[0m \033[1;33m{model_info['name']}\033[0m ({model_info['id']})\n"
        f"\033[1;34m╰─ 📁 Project Root:\033[0m {proj_dir}\n\n"
    )

    forge_system = (
        "You are an autonomous full-stack project generator. "
        "Generate a complete, multi-file runnable project in response to the user's prompt. "
        "Format EVERY file using this exact header immediately before its code block:\n"
        "### FILE: relative/path/to/file.ext\n"
        "```lang\n...full file content...\n```\n"
        "Always include a `### FILE: run.sh` script that installs any dependencies and runs or tests the project."
    )

    output = stream_chat(route_key, prompt, custom_system=forge_system)
    file_pattern = re.compile(r"###\s*FILE:\s*([^\n]+)\n```[a-zA-Z0-9_+-]*\n(.*?)```", re.DOTALL)
    created_files = []

    for match in file_pattern.finditer(output):
        rel_path = match.group(1).strip().lstrip("/")
        content = match.group(2)
        target_path = (proj_dir / rel_path).resolve()
        if str(target_path).startswith(str(proj_dir.resolve())):
            target_path.parent.mkdir(parents=True, exist_ok=True)
            target_path.write_text(content, encoding="utf-8")
            if target_path.suffix == ".sh":
                target_path.chmod(0o755)
            created_files.append(rel_path)

    sys.stderr.write(
        f"\n\033[1;32m======================================================================\033[0m\n"
        f"\033[1;32m✓ FORGED {len(created_files)} PROJECT FILES IN:\033[0m {proj_dir}\n"
    )
    for f in created_files:
        sys.stderr.write(f"  • {f}\n")
    if (proj_dir / "run.sh").exists():
        sys.stderr.write(f"  🚀 Run Project: \033[1;33mcd {proj_dir} && ./run.sh\033[0m\n")
    sys.stderr.write(f"\033[1;32m======================================================================\033[0m\n")

def execute_request(prompt: str, forced_mode: str = None, out_path: str = "venice_output.webp", auto_save_scripts: bool = True):
    if forced_mode:
        route_key = forced_mode
        reason = f"Explicit model override ({route_key})"
    else:
        route_key, reason = neural_classify_intent(prompt)

    model_info = MODEL_CATALOG.get(route_key, MODEL_CATALOG["uncensored"])
    sys.stderr.write(
        f"\033[1;36m╭─ 🧠 Intent:\033[0m {reason}\n"
        f"\033[1;35m╰─ 🎯 Assigned Model:\033[0m \033[1;33m{model_info['name']}\033[0m (\033[0;37m{model_info['id']}\033[0m)\n\n"
    )

    if route_key == "image":
        generate_image(prompt, out_path)
        return

    output = stream_chat(route_key, prompt)

    if auto_save_scripts:
        blocks = extract_code_blocks(output)
        if blocks:
            lang, code = blocks[0]
            ext = "py" if lang in ("python", "py") else ("html" if lang == "html" else ("ts" if lang in ("ts", "typescript") else "sh"))
            last_script = SCRIPTS_DIR / f"last.{ext}"
            last_script.write_text(code, encoding="utf-8")
            last_script.chmod(0o755)
            runner = "uv run" if ext == "py" else ("bun run" if ext == "ts" else ("open" if ext == "html" else "zsh"))
            sys.stderr.write(
                f"\n\033[1;30m💾 Auto-saved runnable code block ➔ {last_script} | Run now: \033[1;32mrunlast\033[0m \033[1;30m({runner} {last_script})\033[0m\n"
            )

def run_last_script():
    candidates = sorted(SCRIPTS_DIR.glob("last.*"), key=lambda p: p.stat().st_mtime, reverse=True)
    if not candidates:
        sys.stderr.write("No recent generated script found in ~/.apex-workspace/scripts/\n")
        return
    target = candidates[0]
    ext = target.suffix.lstrip(".")
    sys.stderr.write(f"\033[1;36m==> 🚀 Running last generated script: {target}...\033[0m\n")
    if ext == "py":
        cmd = ["uv", "run", str(target)] if shutil.which("uv") else [sys.executable, str(target)]
    elif ext in ("ts", "js"):
        cmd = ["bun", "run", str(target)] if shutil.which("bun") else ["node", str(target)]
    elif ext == "html":
        cmd = ["open", str(target)]
    else:
        cmd = ["/bin/zsh", str(target)]
    subprocess.run(cmd)

def browse_workspace_library():
    """Interactive numbered picker for saved scripts, live canvases, and forged projects."""
    scripts = sorted([p for p in SCRIPTS_DIR.iterdir() if p.is_file()], key=lambda p: p.stat().st_mtime, reverse=True)[:15]
    canvases = sorted([p for p in CANVAS_DIR.iterdir() if p.is_dir() and (p / "index.html").exists()], key=lambda p: p.stat().st_mtime, reverse=True)[:10]
    forges = sorted([p for p in FORGE_DIR.iterdir() if p.is_dir()], key=lambda p: p.stat().st_mtime, reverse=True)[:10]

    items = []
    print("\n\033[1;36m📂 SAVED WORKSPACE ASSETS (SCRIPTS, CANVASES & FORGED APPS)\033[0m")
    idx = 1
    if scripts:
        print("  \033[1;33m--- Runnable Scripts (~/.apex-workspace/scripts) ---\033[0m")
        for s in scripts:
            print(f"  \033[1;32m[{idx}]\033[0m 📜 {s.name}")
            items.append(("script", s))
            idx += 1
    if canvases:
        print("  \033[1;33m--- Live Interactive Canvases (http://localhost:7799) ---\033[0m")
        for c in canvases:
            print(f"  \033[1;32m[{idx}]\033[0m 🎨 {c.name}/index.html")
            items.append(("canvas", c))
            idx += 1
    if forges:
        print("  \033[1;33m--- Forged Multi-File Projects (~/.apex-workspace/forge) ---\033[0m")
        for f in forges:
            print(f"  \033[1;32m[{idx}]\033[0m 🏗️  {f.name}")
            items.append(("forge", f))
            idx += 1

    if not items:
        print("  (No saved items yet. Use Option [3] Sandbox or [4] Canvas to create some!)")
        return

    choice = input("\n\033[1;36mSelect item number to run/open (or ENTER to cancel) > \033[0m").strip()
    if not choice.isdigit():
        return
    num = int(choice)
    if 1 <= num <= len(items):
        kind, path = items[num - 1]
        if kind == "script":
            ext = path.suffix.lstrip(".")
            print(f"\033[1;36m==> 🚀 Executing {path}...\033[0m")
            if ext == "py":
                cmd = ["uv", "run", str(path)] if shutil.which("uv") else [sys.executable, str(path)]
            elif ext in ("ts", "js"):
                cmd = ["bun", "run", str(path)] if shutil.which("bun") else ["node", str(path)]
            else:
                cmd = ["/bin/zsh", str(path)]
            subprocess.run(cmd)
        elif kind == "canvas":
            ensure_canvas_server(7799)
            url = f"http://localhost:7799/{path.name}/index.html"
            print(f"\033[1;32m==> 🌐 Opening {url}...\033[0m")
            subprocess.run(["open", url])
        elif kind == "forge":
            run_sh = path / "run.sh"
            if run_sh.exists():
                print(f"\033[1;36m==> 🏗️  Running {run_sh} in {path}...\033[0m")
                subprocess.run(["/bin/zsh", str(run_sh)], cwd=str(path))
            else:
                print(f"\033[1;33mProject path: {path}\033[0m")
                subprocess.run(["ls", "-la", str(path)])

def print_command_center_banner():
    wl_file = WORKSPACE_ROOT / "whitelabel.json"
    header_line = "APEX TERMINAL OS — VENICE SOVEREIGN COMMAND & EXECUTION CENTER"
    if wl_file.exists():
        try:
            wl = json.loads(wl_file.read_text())
            header_line = f"{wl.get('brand', 'APEX TERMINAL OS')} — {wl.get('tagline', 'SOVEREIGN COMMAND CENTER')}"
        except Exception:
            pass
    header_padded = header_line[:68].ljust(68)
    print("\033[1;36m╔══════════════════════════════════════════════════════════════════════════════╗\033[0m")
    print(f"\033[1;36m║\033[0m  🏛️  \033[1;37m{header_padded}\033[0m \033[1;36m║\033[0m")
    print("\033[1;36m╠══════════════════════════════════════════════════════════════════════════════╣\033[0m")
    print("\033[1;36m║\033[0m  \033[1;32m[1]\033[0m 🧠 \033[1;37mNatural-Language Auto-Router\033[0m   (Auto-picks best uncensored model)   \033[1;36m║\033[0m")
    print("\033[1;36m║\033[0m  \033[1;32m[2]\033[0m 🔓 \033[1;37mObliterated Zero-Refusal\033[0m       (Red-team, exploit, 0% refusal v2)   \033[1;36m║\033[0m")
    print("\033[1;36m║\033[0m  \033[1;32m[3]\033[0m 🧪 \033[1;37mHermetic Sandbox & Auto-Run\033[0m    (Build script + run + self-heal)     \033[1;36m║\033[0m")
    print("\033[1;36m║\033[0m  \033[1;32m[4]\033[0m 🎨 \033[1;37mLive Interactive Canvas UI\033[0m     (Build web app/UI & open in Browser) \033[1;36m║\033[0m")
    print("\033[1;36m║\033[0m  \033[1;32m[5]\033[0m 🏗️  \033[1;37mMulti-File Project Forge\033[0m       (Scaffold full-stack app + run.sh)   \033[1;36m║\033[0m")
    print("\033[1;36m║\033[0m  \033[1;32m[6]\033[0m 🖼️  \033[1;37mUncensored Image Studio\033[0m        (Render photorealistic Lustify v8)   \033[1;36m║\033[0m")
    print("\033[1;36m║\033[0m  \033[1;32m[7]\033[0m ⚡ \033[1;37mFrontier Deep Reasoning\033[0m        (GLM 5.2 Architecture, Code & Math)  \033[1;36m║\033[0m")
    print("\033[1;36m║\033[0m  \033[1;32m[8]\033[0m 🎭 \033[1;37mUncensored Roleplay & Copy\033[0m     (Persona, story, aggressive hooks)   \033[1;36m║\033[0m")
    print("\033[1;36m║\033[0m  \033[1;32m[9]\033[0m 🚀 \033[1;37m500+ Command Arsenal Search\033[0m    (Interactive fzf command launcher)   \033[1;36m║\033[0m")
    print("\033[1;36m║\033[0m  \033[1;32m[10]\033[0m 📂 \033[1;37mRun Saved Scripts & Canvases\033[0m  (Browse & execute your workspace)    \033[1;36m║\033[0m")
    print("\033[1;36m║\033[0m  \033[1;32m[11]\033[0m 🌐 \033[1;37mInstant Cloudflare Tunnel\033[0m     (Expose any local port publicly)     \033[1;36m║\033[0m")
    print("\033[1;36m║\033[0m  \033[1;32m[12]\033[0m 🎬 \033[1;37mMedia Downloader (4K / MP3)\033[0m   (Download YouTube/Web video/audio)   \033[1;36m║\033[0m")
    print("\033[1;36m║\033[0m  \033[1;32m[13]\033[0m 💰 \033[1;37mWhite-Label & Stripe Monetize\033[0m (Add your Logo, Brand & Stripe Keys) \033[1;36m║\033[0m")
    print("\033[1;36m║\033[0m  \033[1;33m[0 / ENTER]\033[0m 💻 \033[0;37mDrop straight to normal Zsh terminal prompt (Type `m` anytime)\033[0m \033[1;36m║\033[0m")
    print("\033[1;36m╚══════════════════════════════════════════════════════════════════════════════╝\033[0m")

def interactive_menu(loop_forever: bool = True):
    while True:
        print_command_center_banner()
        try:
            choice = input("\033[1;32m⚡ Pick Ability [1-13], press ENTER for Shell, or type any request > \033[0m").strip()
        except (KeyboardInterrupt, EOFError):
            print("")
            break

        if not choice or choice in ("0", "q", "exit", "quit", "shell"):
            break

        if choice == "1":
            req = input("\033[1;36m🧠 Enter Natural-Language Request > \033[0m").strip()
            if req:
                execute_request(req)
        elif choice == "2":
            req = input("\033[1;31m🔓 Enter Unfiltered / Zero-Refusal Request (Obliterated v2) > \033[0m").strip()
            if req:
                execute_request(req, forced_mode="abliterated")
        elif choice == "3":
            req = input("\033[1;36m🧪 Describe the Script/Task to Build & Execute in Sandbox > \033[0m").strip()
            if req:
                run_sandbox_mode(req)
        elif choice == "4":
            req = input("\033[1;35m🎨 Describe the Interactive Web App / Dashboard / Canvas to Build > \033[0m").strip()
            if req:
                run_canvas_mode(req)
        elif choice == "5":
            req = input("\033[1;34m🏗️  Describe the Multi-File Full-Stack Project to Forge > \033[0m").strip()
            if req:
                run_forge_mode(req)
        elif choice == "6":
            req = input("\033[1;35m🖼️  Describe the Uncensored Image to Generate (lustify-v8) > \033[0m").strip()
            if req:
                out = input("\033[1;30mOutput filename [default: venice_output.webp] > \033[0m").strip() or "venice_output.webp"
                generate_image(req, out)
        elif choice == "7":
            req = input("\033[1;33m⚡ Enter Complex Architecture / Coding / Math Request (GLM 5.2) > \033[0m").strip()
            if req:
                execute_request(req, forced_mode="frontier")
        elif choice == "8":
            req = input("\033[1;35m🎭 Enter Uncensored Roleplay / Persona / Copywriting Request > \033[0m").strip()
            if req:
                execute_request(req, forced_mode="roleplay")
        elif choice == "9":
            apex_bin = Path.home() / ".local/bin/apex"
            if apex_bin.exists():
                subprocess.run([str(apex_bin)])
            else:
                print("Apex arsenal binary not found.")
        elif choice == "10":
            browse_workspace_library()
        elif choice == "11":
            port = input("\033[1;36m🌐 Enter Local Port to Expose via Cloudflare Tunnel [default: 7799] > \033[0m").strip() or "7799"
            subprocess.run(["cloudflared", "tunnel", "--url", f"http://localhost:{port}"])
        elif choice == "12":
            url = input("\033[1;36m🎬 Paste Video/Audio URL > \033[0m").strip()
            if url:
                fmt = input("Download as [1] 4K/1080p MP4 Video or [2] Best MP3 Audio? [1/2] > ").strip()
                if fmt == "2":
                    subprocess.run(["yt-dlp", "-x", "--audio-format", "mp3", "--audio-quality", "0", url])
                else:
                    subprocess.run(["yt-dlp", "-f", "bv*[ext=mp4]+ba[ext=m4a]/b[ext=mp4]", "--merge-output-format", "mp4", url])
        elif choice == "13":
            wl_bin = Path.home() / ".local/bin/apex-whitelabel"
            if not wl_bin.exists():
                wl_bin = Path(__file__).resolve().parent / "apex-whitelabel"
            subprocess.run([sys.executable, str(wl_bin), "--wizard"])
        else:
            # User typed natural language directly into the menu prompt!
            execute_request(choice)

        if not loop_forever:
            break
        print("")
        cont = input("\033[1;30m[Press ENTER to return to Ability Menu, or '0' for Zsh Shell] > \033[0m").strip()
        if cont in ("0", "q", "exit", "shell"):
            break

def main():
    prog_name = os.path.basename(sys.argv[0])
    forced_mode = None
    exec_mode = "chat"

    if prog_name in ("menu", "m", "apex-menu"):
        interactive_menu(loop_forever=True)
        return
    elif prog_name in ("sandbox", "apex-sandbox", "do-task"):
        exec_mode = "sandbox"
    elif prog_name in ("canvas", "apex-canvas"):
        exec_mode = "canvas"
    elif prog_name in ("forge", "apex-forge"):
        exec_mode = "forge"
    elif prog_name == "runlast":
        run_last_script()
        return
    elif prog_name in ("venice-ab", "ab"):
        forced_mode = "abliterated"
    elif prog_name in ("venice-heretic", "heretic"):
        forced_mode = "heretic"
    elif prog_name in ("venice-glm", "vg"):
        forced_mode = "frontier"
    elif prog_name in ("venice-rp", "vrp"):
        forced_mode = "roleplay"
    elif prog_name in ("venice-gemma", "vgemma"):
        forced_mode = "gemma"
    elif prog_name in ("venice-oss", "voss"):
        forced_mode = "oss"
    elif prog_name in ("venice-cheap", "vcheap"):
        forced_mode = "cheap"
    elif prog_name in ("venice-img", "vimg"):
        forced_mode = "image"
    elif prog_name in ("venice-u", "u"):
        forced_mode = "uncensored"

    args = sys.argv[1:]
    while args and args[0].startswith("--"):
        flag = args[0][2:].lower()
        if flag == "menu":
            interactive_menu(loop_forever=True)
            return
        elif flag == "startup-menu":
            interactive_menu(loop_forever=True)
            return
        elif flag in ("run", "sandbox", "exec"):
            exec_mode = "sandbox"
            args = args[1:]
        elif flag == "canvas":
            exec_mode = "canvas"
            args = args[1:]
        elif flag == "forge":
            exec_mode = "forge"
            args = args[1:]
        elif flag in MODEL_CATALOG:
            forced_mode = flag
            args = args[1:]
        elif flag in ("help", "h"):
            print_command_center_banner()
            sys.exit(0)
        else:
            break

    if not args and sys.stdin.isatty():
        interactive_menu(loop_forever=True)
        sys.exit(0)

    out_path = "venice_output.webp"
    if forced_mode == "image" and len(args) > 1 and args[-1].endswith((".webp", ".png", ".jpg")):
        out_path = args[-1]
        args = args[:-1]

    if not args and not sys.stdin.isatty():
        prompt = sys.stdin.read().strip()
    else:
        prompt = " ".join(args)
        if not sys.stdin.isatty():
            piped_input = sys.stdin.read().strip()
            prompt = f"{prompt}\n\nContext:\n{piped_input}"

    if exec_mode == "sandbox":
        run_sandbox_mode(prompt, forced_mode=forced_mode)
    elif exec_mode == "canvas":
        run_canvas_mode(prompt, forced_mode=forced_mode)
    elif exec_mode == "forge":
        run_forge_mode(prompt, forced_mode=forced_mode)
    else:
        execute_request(prompt, forced_mode=forced_mode, out_path=out_path)

if __name__ == "__main__":
    main()
