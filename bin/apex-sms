#!/usr/bin/env python3
"""
apex-sms — Sovereign Terminal SMS & iMessage Messenger
Engineered exclusively for Rick Jefferson | RJ Business Solutions
Enables sending text messages to contacts and phone numbers directly from your terminal or iPhone via macOS Messages.app.

Usage:
  apex-sms "+19453088003" "Build complete and verified."
  apex-sms "Jackie" "The contract has been sent."
  apex-sms --search "Rick"
  apex-sms                 # Interactive prompt
"""

import argparse
import re
import subprocess
import sys
from typing import List, Tuple, Optional


def clean_phone_number(raw: str) -> str:
    """Normalize phone numbers to E.164 international format (+1XXXXXXXXXX for US)."""
    digits = re.sub(r"[^\d+]", "", raw.strip())
    if digits.startswith("+"):
        return digits
    # Strip US leading 1 if 11 digits
    if len(digits) == 11 and digits.startswith("1"):
        return "+" + digits
    if len(digits) == 10:
        return "+1" + digits
    return "+" + digits if digits else ""


def find_contacts(query: str) -> List[Tuple[str, str]]:
    """Query macOS Contacts.app via AppleScript for matching names and phone numbers."""
    safe_query = query.replace('\\', '\\\\').replace('"', '\\"')
    script = f'''
    tell application "Contacts"
        set pList to (people whose name contains "{safe_query}")
        set outList to {{}}
        repeat with p in pList
            set pName to name of p
            repeat with ph in phones of p
                set end of outList to (pName & "|" & (value of ph))
            end repeat
        end repeat
        return outList
    end tell
    '''
    res = subprocess.run(["osascript", "-e", script], capture_output=True, text=True)
    if res.returncode != 0 or not res.stdout.strip():
        return []

    results = []
    # osascript returns comma-delimited strings
    entries = [e.strip() for e in res.stdout.strip().split(", ")]
    for entry in entries:
        if "|" in entry:
            name, phone = entry.split("|", 1)
            results.append((name.strip(), phone.strip()))
    return results


def send_imessage(recipient_phone: str, message: str) -> Tuple[bool, str]:
    """Dispatch an iMessage or SMS via macOS Messages.app from Rick's phone number."""
    safe_msg = message.replace('\\', '\\\\').replace('"', '\\"')
    script = f'''
    tell application "Messages"
        try
            set s to 1st service whose service type is iMessage
            set b to buddy "{recipient_phone}" of s
            send "{safe_msg}" to b
            return "OK"
        on error err
            return "ERROR: " & err
        end try
    end tell
    '''
    res = subprocess.run(["osascript", "-e", script], capture_output=True, text=True)
    out = res.stdout.strip()
    if "OK" in out:
        return True, "Delivered via macOS Messages.app"
    return False, out or res.stderr.strip() or "Failed to send message"


def main():
    parser = argparse.ArgumentParser(description="Apex Sovereign Terminal SMS Messenger")
    parser.add_argument("recipient", nargs="?", default="", help="Contact name (e.g. 'Jackie') or Phone Number (e.g. '+19453088003')")
    parser.add_argument("message", nargs="?", default="", help="Text message content to send")
    parser.add_argument("--search", "-s", type=str, help="Search contacts in address book")
    args = parser.parse_args()

    print("\033[1;34m╭─ ⚡ APEX SOVEREIGN MESSENGER · RJ BUSINESS SOLUTIONS\033[0m")
    print("\033[1;30m├─ Sender ID: Rick Jefferson · iPhone 14 (+1 945-308-8003)\033[0m")

    # Search Mode
    if args.search:
        print(f"\033[1;36m├─ 🔍 Searching macOS Contacts for '{args.search}'...\033[0m")
        matches = find_contacts(args.search)
        if not matches:
            print("\033[1;31m╰─ ✗ No matching contacts found.\033[0m")
            return
        print(f"\033[1;32m├─ Found {len(matches)} match(es):\033[0m")
        for idx, (name, ph) in enumerate(matches, 1):
            cleaned = clean_phone_number(ph)
            print(f"│  {idx}. \033[1;37m{name}\033[0m &rarr; \033[1;36m{cleaned}\033[0m ({ph})")
        print("\033[1;34m╰─ To send: apex-sms \"<Name or Phone>\" \"<Message>\"\033[0m")
        return

    recipient_input = args.recipient
    message_input = args.message

    # Interactive prompt if missing args
    if not recipient_input:
        try:
            recipient_input = input("\033[1;33m├─ Recipient (Contact Name or Phone Number): \033[0m").strip()
        except (KeyboardInterrupt, EOFError):
            print("\n\033[1;31mCancelled.\033[0m")
            return

    if not recipient_input:
        print("\033[1;31m╰─ ✗ Error: Recipient is required.\033[0m")
        return

    # Check if recipient is a phone number or a contact name
    target_name = recipient_input
    target_phone = ""

    # Check if purely phone digits
    if re.search(r"^\+?[\d\s\-\(\)\.]{7,20}$", recipient_input):
        target_phone = clean_phone_number(recipient_input)
        target_name = target_phone
    else:
        # Search Contact
        matches = find_contacts(recipient_input)
        if matches:
            target_name, raw_ph = matches[0]
            target_phone = clean_phone_number(raw_ph)
            print(f"\033[1;32m├─ 📇 Resolved Contact:\033[0m \033[1;37m{target_name}\033[0m &rarr; \033[1;36m{target_phone}\033[0m")
        else:
            # Fallback to cleaning input as phone
            target_phone = clean_phone_number(recipient_input)
            if len(re.sub(r'\D', '', target_phone)) < 10:
                print(f"\033[1;31m╰─ ✗ Could not find contact '{recipient_input}' or valid phone number.\033[0m")
                return

    if not message_input:
        try:
            message_input = input("\033[1;33m├─ Message Text: \033[0m").strip()
        except (KeyboardInterrupt, EOFError):
            print("\n\033[1;31mCancelled.\033[0m")
            return

    if not message_input:
        print("\033[1;31m╰─ ✗ Error: Message cannot be empty.\033[0m")
        return

    print(f"\033[1;35m├─ 🚀 Dispatching text to {target_name} ({target_phone})...\033[0m")
    success, detail = send_imessage(target_phone, message_input)

    if success:
        print(f"\033[1;32m╰─ ✓ SENT SUCCESSFULLY:\033[0m \"{message_input}\" &rarr; \033[1;37m{target_phone}\033[0m")
    else:
        print(f"\033[1;31m╰─ ✗ Send Failed:\033[0m {detail}")
        sys.exit(1)


if __name__ == "__main__":
    main()
