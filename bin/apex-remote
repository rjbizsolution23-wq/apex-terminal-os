          <div class="mt-4 pt-3 border-t border-slate-800/60 flex items-center gap-2">
            <button onclick="copySiriWebhook()" id="btn-copy-siri" class="bg-blue-600 hover:bg-blue-500 text-xs font-bold text-white px-3 py-2 rounded-lg flex items-center gap-2 transition flex-1 justify-center shadow-sm">
              <span>📋</span> <span>Copy Siri Webhook URL</span>
            </button>
            <button onclick="testSiriDispatch()" id="btn-test-siri" class="bg-slate-800 hover:bg-slate-700 text-xs font-semibold text-slate-200 px-3 py-2 rounded-lg flex items-center gap-1.5 transition">
              <span>⚡</span> <span>Test Dispatch</span>
            </button>
          </div>
        </div>

      </div>

      <!-- Card C: 24/7 Always-On MacBook Persistence Info -->
      <div class="bg-slate-900/60 border border-slate-800/80 rounded-xl p-4 flex items-center justify-between flex-wrap gap-3">
        <div class="flex items-center gap-3">
          <span class="text-2xl">🛡️</span>
          <div>
