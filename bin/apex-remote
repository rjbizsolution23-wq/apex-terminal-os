ENV_FILE = pathlib.Path.home() / ".apex-workspace" / ".env"

# ---------- Auto-Load Sovereign Credentials Vault ----------
if ENV_FILE.exists():
    for _line in ENV_FILE.read_text(encoding="utf-8", errors="replace").splitlines():
        _line = _line.strip()
        if _line.startswith("export "):
            _line = _line[7:].strip()
        if _line and not _line.startswith("#") and "=" in _line:
            _k, _v = _line.split("=", 1)
            os.environ[_k.strip()] = _v.strip().strip('"').strip("'")


# ---------- Sovereign macOS SMS & Contacts Integration ----------
def clean_phone_number(raw: str) -> str:
    """Normalize phone numbers to E.164 international format (+1XXXXXXXXXX for US)."""
    digits = re.sub(r"[^\d+]", "", raw.strip())
    if digits.startswith("+"):
        return digits
    if len(digits) == 11 and digits.startswith("1"):
        return "+" + digits
    if len(digits) == 10:
        return "+1" + digits
    return "+" + digits if digits else ""


CLIENTS_FILE = os.path.expanduser("~/.apex-workspace/clients.json")

def load_clients() -> List[Dict]:
    if not os.path.exists(CLIENTS_FILE):
        return []
    try:
        with open(CLIENTS_FILE, 'r', encoding='utf-8') as f:
            data = json.load(f)
            return data if isinstance(data, list) else []
    except Exception:
        return []


def find_contacts(query: str):
    """Query ~/.apex-workspace/clients.json and macOS Contacts for matching names and phone numbers."""
    results = []
    q_clean = clean_phone_number(query)
    q_lower = query.strip().lower()

    # 1. Check clients.json first
    for c in load_clients():
        cname = c.get("name", "")
        cphone = c.get("phone", "")
        if (q_lower and q_lower in cname.lower()) or (q_clean and clean_phone_number(cphone) == q_clean):
            results.append((f"{cname} [Client]", cphone))

    # 2. Query macOS Contacts via AppleScript
    safe_query = query.replace('\\', '\\\\').replace('"', '\\"')
    script = f'''
    tell application "Contacts"
        set pList to (people whose name contains "{safe_query}")
        set outList to {{}}
        repeat with p in pList
            set pName to name of p
            repeat with ph in phones of p
                set end of outList to (pName & "|" & (value of ph))
            end repeat
        end repeat
        return outList
    end tell
    '''
    res = subprocess.run(["osascript", "-e", script], capture_output=True, text=True)
    if res.returncode == 0 and res.stdout.strip():
        entries = [e.strip() for e in res.stdout.strip().split(", ")]
        for entry in entries:
            if "|" in entry:
                name, phone = entry.split("|", 1)
                results.append((name.strip(), phone.strip()))
    return results


def send_imessage(recipient_phone: str, message: str) -> Tuple[bool, str]:
    """Dispatch an iMessage or SMS via macOS Messages.app with automatic dual-route fallback."""
    safe_msg = message.replace('\\', '\\\\').replace('"', '\\"')
    safe_phone = recipient_phone.replace('\\', '\\\\').replace('"', '\\"')
    script = f'''
    tell application "Messages"
        -- Try iMessage first
        try
            set s to 1st account whose service type is iMessage
            set p to participant "{safe_phone}" of s
            send "{safe_msg}" to p
            return "OK:iMessage"
        on error err1
            -- Fallback to Cellular SMS
            try
                set s to 1st account whose service type is SMS
                set p to participant "{safe_phone}" of s
                send "{safe_msg}" to p
                return "OK:SMS"
            on error err2
                return "FAIL: iMessage(" & err1 & ") | SMS(" & err2 & ")"
            end try
        end try
    end tell
    '''
    res = subprocess.run(["osascript", "-e", script], capture_output=True, text=True)
    out = res.stdout.strip()
    if out.startswith("OK:"):
        route = out.split(":", 1)[1]
        return True, f"Delivered via {route}"
    return False, out or res.stderr.strip() or "Failed to send message"


