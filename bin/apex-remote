        self.end_headers()
        self.wfile.write(DASHBOARD_HTML.encode("utf-8"))

    def do_POST(self):
        url_parts = urllib.parse.urlparse(self.path)
        path = url_parts.path

        if path.startswith("/terminal"):
            self.forward_raw_to_ttyd()
            return

        # Voice task execution endpoint
        if path == "/api/voice-task":
            content_len = int(self.headers.get("Content-Length") or 0)
            body = self.rfile.read(content_len).decode("utf-8")
            data = json.loads(body) if body else {}

            # Optional PIN validation
            req_pin = data.get("pin") or self.headers.get("X-Apex-PIN") or urllib.parse.parse_qs(url_parts.query).get("pin", [""])[0]
            if req_pin and req_pin != self.pin:
                self.send_response(401)
                self.send_header("Content-Type", "application/json")
                self.end_headers()
                self.wfile.write(json.dumps({"status": "error", "error": "Unauthorized PIN"}).encode("utf-8"))
                return

            task = data.get("task", "").strip()
            model = data.get("model", "zai-org-glm-5-2")
            yolo = bool(data.get("yolo", True))
            audio_feedback = bool(data.get("audio_feedback", True))

            if not task:
                self.send_response(400)
                self.send_header("Content-Type", "application/json")
                self.end_headers()
                self.wfile.write(json.dumps({"status": "error", "error": "No task provided"}).encode("utf-8"))
                return

            # Mac Audio Announcement
            if audio_feedback:
                subprocess.Popen(["say", "-v", "Samantha", f"Starting remote task: {task[:50]}"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

            # Build apex-agent command line
            agent_bin = pathlib.Path.home() / ".local/bin/apex-agent"
            if not agent_bin.exists():
                agent_bin = pathlib.Path(__file__).resolve().parent / "apex-agent"

            cmd = [sys.executable, str(agent_bin)]
            if yolo:
                cmd.extend(["--trust", "yolo"])
            cmd.extend(["--model", model])
            cmd.append(task)

            # Run apex-agent in workspace dir with full environment
            work_dir = os.environ.get("WORKSPACE_DIR") or str(pathlib.Path.home() / "Downloads" / "Super-agents266")
            if not pathlib.Path(work_dir).exists():
                work_dir = str(pathlib.Path.home())
            r = subprocess.run(cmd, capture_output=True, text=True, timeout=180, cwd=work_dir, env=os.environ)
            full_output = (r.stdout + r.stderr).strip()

            summary = f"Task completed on your MacBook: {task[:40]}"
            if "✓" in full_output:
                summary = "Build and verification succeeded on your MacBook."
            elif "ERROR" in full_output or "✗" in full_output:
                summary = "Task encountered an error. Check logs on your screen."

            # Announce completion on Mac
            if audio_feedback:
                subprocess.Popen(["say", "-v", "Samantha", summary], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

            self.send_response(200)
            self.send_header("Content-Type", "application/json")
            self.send_header("Access-Control-Allow-Origin", "*")
            self.end_headers()
            self.wfile.write(json.dumps({"status": "ok", "output": full_output, "summary": summary}).encode("utf-8"))
            return

        # SMS Dispatch Endpoint
        if path == "/api/send-sms":
            content_len = int(self.headers.get("Content-Length") or 0)
            body = self.rfile.read(content_len).decode("utf-8")
            data = json.loads(body) if body else {}

            req_pin = data.get("pin") or self.headers.get("X-Apex-PIN") or urllib.parse.parse_qs(url_parts.query).get("pin", [""])[0]
            if req_pin and req_pin != self.pin:
                self.send_response(401)
                self.send_header("Content-Type", "application/json")
                self.end_headers()
                self.wfile.write(json.dumps({"status": "error", "error": "Unauthorized PIN"}).encode("utf-8"))
                return

            recipient = data.get("recipient", "").strip()
            msg = data.get("message", "").strip()
            if not recipient or not msg:
                self.send_response(400)
                self.send_header("Content-Type", "application/json")
                self.end_headers()
                self.wfile.write(json.dumps({"status": "error", "error": "Recipient and message are required"}).encode("utf-8"))
                return

            target_phone = clean_phone_number(recipient)
            target_name = recipient
            if not re.search(r"^\+?[\d\s\-\(\)\.]{7,20}$", recipient):
                matches = find_contacts(recipient)
                if matches:
                    target_name, raw_ph = matches[0]
                    target_phone = clean_phone_number(raw_ph)
                else:
                    self.send_response(404)
                    self.send_header("Content-Type", "application/json")
                    self.end_headers()
                    self.wfile.write(json.dumps({"status": "error", "error": f"Contact '{recipient}' not found in macOS address book"}).encode("utf-8"))
                    return

            success, detail = send_imessage(target_phone, msg)
            self.send_response(200 if success else 500)
            self.send_header("Content-Type", "application/json")
            self.send_header("Access-Control-Allow-Origin", "*")
            self.end_headers()
            self.wfile.write(json.dumps({
                "status": "ok" if success else "error",
                "recipient": target_phone,
                "name": target_name,
                "message": msg,
                "detail": detail,
                "sender": "Rick Jefferson (+1 945-308-8003)"
            }).encode("utf-8"))
            return

        # Photos Action Endpoint
        if path == "/api/photos-action":
            content_len = int(self.headers.get("Content-Length") or 0)
            body = self.rfile.read(content_len).decode("utf-8")
            data = json.loads(body) if body else {}

            req_pin = data.get("pin") or self.headers.get("X-Apex-PIN") or urllib.parse.parse_qs(url_parts.query).get("pin", [""])[0]
            if req_pin and req_pin != self.pin:
                self.send_response(401)
                self.send_header("Content-Type", "application/json")
                self.end_headers()
                self.wfile.write(json.dumps({"status": "error", "error": "Unauthorized PIN"}).encode("utf-8"))
                return

            action = data.get("action", "scan")
            photo_bin = pathlib.Path.home() / ".local/bin/apex-photos"
            if not photo_bin.exists():
                photo_bin = pathlib.Path(__file__).resolve().parent / "apex-photos"

            cmd = [sys.executable, str(photo_bin)]
            if action == "clean_duplicates":
                cmd.extend(["--clean-duplicates", "--execute"])
            elif action == "clean_screenshots":
                cmd.extend(["--clean-screenshots", "--days", str(data.get("days", 14)), "--execute"])
            elif action == "clean_recordings":
                cmd.extend(["--clean-recordings", "--days", str(data.get("days", 14)), "--min-mb", str(data.get("min_mb", 20)), "--execute"])
            elif action == "organize":
                cmd.extend(["--organize", str(pathlib.Path.home() / "Downloads"), "--execute"])
            elif action == "photos_app":
                cmd.append("--photos-app")
            elif action == "albums":
                cmd.append("--albums")
            elif action == "duplicates":
                cmd.append("--duplicates")
            else:
                cmd.append("--scan")

            r = subprocess.run(cmd, capture_output=True, text=True, timeout=60)
            self.send_response(200)
            self.send_header("Content-Type", "application/json")
            self.send_header("Access-Control-Allow-Origin", "*")
            self.end_headers()
            self.wfile.write(json.dumps({"status": "ok", "action": action, "output": r.stdout}).encode("utf-8"))
            return

        # Messages Clean Endpoint
        if path == "/api/messages-clean":
            content_len = int(self.headers.get("Content-Length") or 0)
            body = self.rfile.read(content_len).decode("utf-8")
            data = json.loads(body) if body else {}

            req_pin = data.get("pin") or self.headers.get("X-Apex-PIN") or urllib.parse.parse_qs(url_parts.query).get("pin", [""])[0]
            if req_pin and req_pin != self.pin:
                self.send_response(401)
                self.send_header("Content-Type", "application/json")
                self.end_headers()
                self.wfile.write(json.dumps({"status": "error", "error": "Unauthorized PIN"}).encode("utf-8"))
                return

            action = data.get("action", "clean_attachments")
            msg_bin = pathlib.Path.home() / ".local/bin/apex-messages"
            if not msg_bin.exists():
                msg_bin = pathlib.Path(__file__).resolve().parent / "apex-messages"

            cmd = [sys.executable, str(msg_bin)]
            if action == "clean_attachments":
                min_mb = data.get("min_mb", 50)
                cmd.extend(["--clean-attachments", str(min_mb), "--execute"])
            elif action == "spam":
                cmd.append("--spam")
            else:
                cmd.append("--large-attachments")

            r = subprocess.run(cmd, capture_output=True, text=True, timeout=60)
            self.send_response(200)
            self.send_header("Content-Type", "application/json")
            self.send_header("Access-Control-Allow-Origin", "*")
            self.end_headers()
            self.wfile.write(json.dumps({"status": "ok", "action": action, "output": r.stdout}).encode("utf-8"))
            return

        self.send_response(404)
        self.end_headers()

    def forward_raw_to_ttyd(self):
        """Bridges HTTP and WebSockets seamlessly between client and ttyd."""
        try:
            upstream = socket.create_connection(("127.0.0.1", self.ttyd_port), timeout=10)
        except Exception as e:
            self.send_response(502)
            self.send_header("Content-Type", "text/plain")
            self.end_headers()
            self.wfile.write(f"ttyd upstream unavailable: {e}".encode("utf-8"))
            return

        req_lines = [f"{self.command} {self.path} {self.request_version}"]
        for k, v in self.headers.items():
            req_lines.append(f"{k}: {v}")

        req_bytes = "\r\n".join(req_lines).encode("utf-8") + b"\r\n\r\n"
        upstream.sendall(req_bytes)

        client_sock = self.connection
        sockets = [client_sock, upstream]
        try:
            while True:
                r, _, _ = select.select(sockets, [], [], 120.0)
                if not r:
                    break
                for s in r:
                    other = upstream if s is client_sock else client_sock
                    data = s.recv(16384)
                    if not data:
                        return
                    other.sendall(data)
        except Exception:
            pass
        finally:
            upstream.close()


# ---------- Cloudflare Tunnel Runner ----------
def start_cloudflare_tunnel(port: int) -> Tuple[subprocess.Popen, str]:
    cloudflared_bin = shutil.which("cloudflared") or "/opt/homebrew/bin/cloudflared"
    proc = subprocess.Popen(
        [cloudflared_bin, "tunnel", "--url", f"http://localhost:{port}"],
        stderr=subprocess.PIPE,
        stdout=subprocess.DEVNULL,
        text=True,
    )
    public_url = ""
    t0 = time.time()
    while time.time() - t0 < 20:
        line = proc.stderr.readline()
        if not line:
            time.sleep(0.1)
            continue
        m = re.search(r"https://[a-zA-Z0-9-]+\.trycloudflare\.com", line)
        if m:
            public_url = m.group(0)
            break
    return proc, public_url


# ---------- Main CLI Entrypoint ----------
def main() -> None:
    parser = argparse.ArgumentParser(description="Apex Remote & Voice Command Gateway")
    parser.add_argument("--port", type=int, default=7795, help="Remote Gateway port (default: 7795)")
    parser.add_argument("--ttyd-port", type=int, default=7681, help="ttyd terminal port (default: 7681)")
    parser.add_argument("--pin", type=str, default="", help="Remote PIN credential")
    parser.add_argument("--local-only", action="store_true", help="Skip Cloudflare public tunnel")
    args = parser.parse_args()

    # Determine PIN
    pin = args.pin
    if not pin:
        if AUTH_FILE.exists():
            pin = AUTH_FILE.read_text().strip()
        else:
            pin = str(random.randint(100000, 999999))
            AUTH_FILE.parent.mkdir(parents=True, exist_ok=True)
            AUTH_FILE.write_text(pin)

    # 1. Start ttyd
    ttyd_bin = shutil.which("ttyd") or "/opt/homebrew/bin/ttyd"
    print("\033[1;36m╭─ 🌐 STARTING APEX REMOTE & SOVEREIGN VOICE COMMAND CENTER\033[0m")
    print(f"\033[1;34m├─ 🖥️  Launching ttyd Terminal on :7681 (PIN: {pin})\033[0m")
    
    # Kill any stale ttyd on this port
    subprocess.run(["pkill", "-f", f"ttyd.*{args.ttyd_port}"], capture_output=True)
    time.sleep(0.3)

    work_dir = os.environ.get("WORKSPACE_DIR") or str(pathlib.Path.home() / "Downloads" / "Super-agents266")
    if not pathlib.Path(work_dir).exists():
        work_dir = str(pathlib.Path.home())

    ttyd_proc = subprocess.Popen(
        [ttyd_bin, "-W", "-b", "/terminal", "-p", str(args.ttyd_port), "-w", work_dir, "zsh"],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )
    time.sleep(0.5)

    # 2. Start Gateway Server on 7795
    socketserver.ThreadingTCPServer.allow_reuse_address = True
    SovereignRemoteHandler.ttyd_port = args.ttyd_port
    SovereignRemoteHandler.pin = pin
    server = socketserver.ThreadingTCPServer(("0.0.0.0", args.port), SovereignRemoteHandler)
    server_thread = threading.Thread(target=server.serve_forever)
    server_thread.daemon = True
    server_thread.start()

    local_url = f"http://localhost:{args.port}?pin={pin}"
    public_url = ""
    tunnel_proc = None

    if not args.local_only:
        print(f"\033[1;35m├─ 🔒 Spawning Cloudflare Zero Trust Public Tunnel...\033[0m")
        tunnel_proc, public_url = start_cloudflare_tunnel(args.port)

    active_url = public_url if public_url else local_url

    print(f"\033[1;32m├─ 📱 Active Gateway URL:\033[0m \033[1;37;44m {active_url} \033[0m")
    print(f"\033[1;33m├─ 🔑 Remote Credentials:\033[0m PIN: \033[1;37m{pin}\033[0m")
    print(f"\033[1;36m├─ 🎙️  Voice Intelligence:\033[0m Multi-Engine Web Speech + Keyboard Dictation + Mac /usr/bin/say")

    # Copy to clipboard
    subprocess.run(["pbcopy"], input=active_url.encode("utf-8"), check=False)
    print("\033[1;32m├─ 📋 Copied Remote URL to macOS clipboard!\033[0m")

    # Print ASCII QR Code
    if shutil.which("qrencode"):
        print("\033[1;35m╰─ 📲 SCAN QR CODE WITH YOUR IPHONE / IPAD CAMERA TO CONNECT:\033[0m\n")
        subprocess.run(["qrencode", "-t", "UTF8", active_url])
        print("")
    else:
        print(f"\033[1;35m╰─ 📲 Open on your phone: {active_url}\033[0m\n")

    # Voice announcement on Mac
    subprocess.Popen(["say", "-v", "Samantha", "Apex Remote and Voice Command Center is live. Ready for remote build."], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    try:
        while True:
            time.sleep(1)
    except KeyboardInterrupt:
        print("\n\033[1;31mShutting down Apex Remote Gateway...\033[0m")
        if tunnel_proc:
            tunnel_proc.terminate()
        ttyd_proc.terminate()
        server.shutdown()
        print("✓ Done.")


if __name__ == "__main__":
    main()
