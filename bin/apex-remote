        <div class="space-y-1.5">
          <label class="text-[11px] font-semibold text-slate-400 uppercase tracking-wider flex items-center gap-1">
            <span>📟</span> <span>Optimizer Output</span>
          </label>
          <div id="photos-output-box" class="bg-slate-950 border border-slate-800 rounded-xl p-3 font-mono text-xs text-slate-300 max-h-60 overflow-y-auto whitespace-pre-wrap leading-relaxed">
            Ready. Tap any action above to run image organization or storage cleanup.
          </div>
        </div>
      </div>
    </section>

  </main>

  <script>
    // ---------- State & Device Pairing ----------
    let isRecording = false;
    let recognitionInstance = null;
    let activeTab = 'voice';

    // Auto-save and retrieve PIN from localStorage
    const urlParams = new URLSearchParams(window.location.search);
    const pinFromUrl = urlParams.get('pin');
    if (pinFromUrl) {
      localStorage.setItem('apex_pin', pinFromUrl);
    }
    function getActivePin() {
      return localStorage.getItem('apex_pin') || pinFromUrl || '408100';
    }

    function focusInput() {
      const el = document.getElementById('task-input');
      el.focus();
      el.scrollIntoView({ behavior: 'smooth', block: 'center' });
    }

    // ---------- Tab Switching ----------
    function switchTab(tabId) {
      activeTab = tabId;
      ['voice', 'terminal', 'actions', 'sms', 'photos', 'iphone'].forEach(id => {
        const view = document.getElementById('view-' + id);
        const btn = document.getElementById('tab-' + id);
        if (view && btn) {
          if (id === tabId) {
            view.classList.remove('hidden');
            btn.classList.add('bg-blue-600', 'text-white');
            btn.classList.remove('bg-slate-800', 'text-slate-300');
          } else {
            view.classList.add('hidden');
            btn.classList.remove('bg-blue-600', 'text-white');
            btn.classList.add('bg-slate-800', 'text-slate-300');
          }
        }
      });
      if (tabId === 'sms') {
        loadRecentMessages();
      } else if (tabId === 'photos') {
        runPhotoAction('scan');
      }
    }

    // ---------- Robust Multi-Engine Voice Recognition ----------
    async function handleMicButtonPress() {
      if (isRecording) {
        stopVoiceRecognition();
        return;
      }
      startVoiceRecognition();
    }

    async function startVoiceRecognition() {
      const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;

      // Haptic feedback
      if (navigator.vibrate) {
        navigator.vibrate([80]);
      }

      if (!SpeechRecognition) {
        document.getElementById('voice-state').textContent = 'Dictation Tip: Tap text box below & hit iPhone mic (🎙️)';
        focusInput();
        return;
      }

      try {
        // Ensure microphone permissions on Safari / iOS
        if (navigator.mediaDevices && navigator.mediaDevices.getUserMedia) {
          try {
            await navigator.mediaDevices.getUserMedia({ audio: true });
          } catch(err) {
            console.warn('getUserMedia prompt bypass/error:', err);
          }
        }

        // Always create a FRESH recognition instance to avoid WebKit crash
        recognitionInstance = new SpeechRecognition();
        recognitionInstance.continuous = false;
        recognitionInstance.interimResults = true;
        recognitionInstance.lang = 'en-US';

        recognitionInstance.onstart = () => {
          isRecording = true;
          const btn = document.getElementById('mic-button');
          btn.classList.add('ring-4', 'ring-red-500', 'from-red-600', 'to-rose-400', 'pulse-ring');
          document.getElementById('mic-icon').textContent = '🔴';
          document.getElementById('voice-state').textContent = '🔴 Listening... Speak now (Tap to stop)';
          document.getElementById('voice-waves').classList.remove('opacity-0');
        };

        recognitionInstance.onresult = (e) => {
          let transcript = '';
          for (let i = 0; i < e.results.length; i++) {
            transcript += e.results[i][0].transcript;
          }
          document.getElementById('task-input').value = transcript;
          document.getElementById('char-count').textContent = transcript.length + ' chars';
          document.getElementById('voice-state').textContent = 'Heard: "' + transcript.substring(0, 35) + '..."';
        };

        recognitionInstance.onerror = (e) => {
          console.error('Speech recognition error:', e);
          stopVoiceRecognition();
          if (e.error === 'not-allowed') {
            document.getElementById('voice-state').textContent = 'Mic blocked in browser. Use iPhone keyboard mic below.';
            focusInput();
          } else if (e.error === 'no-speech') {
            document.getElementById('voice-state').textContent = 'No speech heard. Tap mic to try again.';
          } else {
            document.getElementById('voice-state').textContent = 'Error: ' + e.error + '. Try keyboard mic below.';
          }
        };

        recognitionInstance.onend = () => {
          stopVoiceRecognition();
          const text = document.getElementById('task-input').value.trim();
          if (text) {
            document.getElementById('voice-state').textContent = 'Executing command on Mac...';
            executeTask();
          } else {
            document.getElementById('voice-state').textContent = 'Tap Mic to Speak to MacBook';
          }
        };

        recognitionInstance.start();
      } catch (err) {
        console.error('Failed to start speech recognition:', err);
        stopVoiceRecognition();
        document.getElementById('voice-state').textContent = 'Tap text box below and use iPhone keyboard mic.';
        focusInput();
      }
    }

    function stopVoiceRecognition() {
      isRecording = false;
      if (recognitionInstance) {
        try { recognitionInstance.stop(); } catch(e) {}
        recognitionInstance = null;
      }
      const btn = document.getElementById('mic-button');
      btn.classList.remove('ring-4', 'ring-red-500', 'from-red-600', 'to-rose-400', 'pulse-ring');
      btn.classList.add('from-blue-600', 'to-sky-400');
      document.getElementById('mic-icon').textContent = '🎙️';
      document.getElementById('voice-waves').classList.add('opacity-0');
    }

    // ---------- Execute Task via Backend API ----------
    async function executeTask() {
      const task = document.getElementById('task-input').value.trim();
      if (!task) return;

      // Intercept spoken SMS/text commands from Voice Studio
      const smsTrigPat = /^(?:send\\s+a\\s+text\\s+to|send\\s+text\\s+to|send\\s+an?\\s+sms\\s+to|send\\s+message\\s+to|shoot\\s+a\\s+text\\s+to|text|tell|sms)\\s+/i;
      if (smsTrigPat.test(task)) {
        switchTab('sms');
        parseAndFillSmsVoice(task);
        if ('speechSynthesis' in window) {
          const utter = new SpeechSynthesisUtterance("Voice text parsed for client. Ready to dispatch.");
          utter.rate = 1.05;
          window.speechSynthesis.speak(utter);
        }
        return;
      }

      const model = document.getElementById('model-select').value;
      const yolo = document.getElementById('trust-yolo').checked;
      const audioFeedback = document.getElementById('audio-feedback').checked;
      const pin = getActivePin();

      const logContainer = document.getElementById('execution-logs');
      logContainer.innerHTML += `<div class="text-blue-400 font-bold mt-2">⚡ [Command Dispatched]: "${task}"</div>`;
      logContainer.scrollTop = logContainer.scrollHeight;

      document.getElementById('btn-execute').disabled = true;
      document.getElementById('btn-execute').classList.add('opacity-50');

      try {
        const resp = await fetch('/api/voice-task', {
          method: 'POST',
          headers: { 
            'Content-Type': 'application/json',
            'X-Apex-PIN': pin
          },
          body: JSON.stringify({ task, model, yolo, audio_feedback: audioFeedback, pin })
        });
        const data = await resp.json();

        if (data.status === 'ok') {
          logContainer.innerHTML += `<div class="text-emerald-400 whitespace-pre-wrap mt-1">${escapeHtml(data.output)}</div>`;
          // Phone Speech Synthesis feedback
          if (audioFeedback && 'speechSynthesis' in window) {
            const summary = data.summary || "Task completed on your MacBook.";
            const utter = new SpeechSynthesisUtterance(summary);
            utter.rate = 1.05;
            window.speechSynthesis.speak(utter);
          }
        } else {
          logContainer.innerHTML += `<div class="text-red-400 mt-1">✗ Error: ${escapeHtml(data.error || 'Execution failed')}</div>`;
        }
      } catch (err) {
        logContainer.innerHTML += `<div class="text-red-400 mt-1">✗ Network Error: ${escapeHtml(err.message)}</div>`;
      } finally {
        document.getElementById('btn-execute').disabled = false;
        document.getElementById('btn-execute').classList.remove('opacity-50');
        logContainer.scrollTop = logContainer.scrollHeight;
      }
    }

    function quickRun(prompt, yolo) {
      document.getElementById('task-input').value = prompt;
      document.getElementById('char-count').textContent = prompt.length + ' chars';
      document.getElementById('trust-yolo').checked = yolo;
      switchTab('voice');
      executeTask();
    }

    function clearLogs() {
      document.getElementById('execution-logs').innerHTML = '<p class="text-slate-500 italic">Logs cleared.</p>';
    }

    function escapeHtml(str) {
      return (str || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
    }

    // ---------- iPhone & Siri Helpers ----------
    function copyToClipboard(text, btnId) {
      navigator.clipboard.writeText(text).then(() => {
        const btn = document.getElementById(btnId);
        const orig = btn.innerHTML;
        btn.innerHTML = '<span>✓</span> <span>Copied to Clipboard!</span>';
        setTimeout(() => { btn.innerHTML = orig; }, 2500);
      });
    }

    function copySiriWebhook() {
      const url = window.location.origin + '/api/voice-task';
      copyToClipboard(url, 'btn-copy-siri');
    }

    function testSiriDispatch() {
      document.getElementById('task-input').value = "Speak MacBook system status and verify test readiness";
      switchTab('voice');
      executeTask();
    }

    // ---------- Send Key to Embedded ttyd Terminal ----------
    function sendKeyToTerminal(key) {
      const frame = document.getElementById('terminal-frame');
      if (frame && frame.contentWindow) {
        frame.contentWindow.postMessage({ type: 'stdin', data: key }, '*');
      }
    }

    function sendTextToTerminal(text) {
      const frame = document.getElementById('terminal-frame');
      if (frame && frame.contentWindow) {
        frame.contentWindow.postMessage({ type: 'stdin', data: text }, '*');
      }
    }

    // ---------- Voice SMS Dictation Engine ----------
    let voiceSmsRecognition = null;
    let isVoiceSmsRecording = false;

    function toggleVoiceSmsDictation() {
      if (isVoiceSmsRecording) {
        stopVoiceSmsDictation();
      } else {
        startVoiceSmsDictation();
      }
    }

    function startVoiceSmsDictation() {
      const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
      if (!SpeechRecognition) {
        alert("Speech recognition is not supported in this browser. Please tap the text box and use the microphone key on your iPhone keyboard (🎙️).");
        return;
      }

      if (navigator.vibrate) navigator.vibrate([60]);

      try {
        voiceSmsRecognition = new SpeechRecognition();
        voiceSmsRecognition.continuous = false;
        voiceSmsRecognition.interimResults = true;
        voiceSmsRecognition.lang = 'en-US';

        const btn = document.getElementById('btn-voice-sms');
        const icon = document.getElementById('voice-sms-icon');
        const badge = document.getElementById('voice-sms-badge');
        const hint = document.getElementById('voice-sms-hint');
        const actions = document.getElementById('voice-sms-actions');

        voiceSmsRecognition.onstart = () => {
          isVoiceSmsRecording = true;
          if (badge) badge.classList.remove('hidden');
          if (actions) actions.classList.remove('hidden');
          if (btn) {
            btn.classList.add('bg-rose-600', 'animate-pulse');
            btn.classList.remove('bg-blue-600');
          }
          if (icon) icon.textContent = '⏹️';
          if (hint) hint.innerHTML = '<span class="text-emerald-400 font-semibold animate-pulse">Listening... Speak recipient &amp; message now.</span>';
        };

        voiceSmsRecognition.onresult = (event) => {
          let transcript = '';
          for (let i = event.resultIndex; i < event.results.length; ++i) {
            transcript += event.results[i][0].transcript;
          }
          transcript = transcript.trim();
          if (hint) hint.innerHTML = `Heard: <span class="text-white font-medium">"${escapeHtml(transcript)}"</span>`;
          parseAndFillSmsVoice(transcript);
        };

        voiceSmsRecognition.onerror = (event) => {
          console.warn('Voice SMS recognition error:', event.error);
          stopVoiceSmsDictation();
          if (hint) hint.innerHTML = `<span class="text-rose-400">Speech note: ${escapeHtml(event.error)}. Try speaking again or type below.</span>`;
        };

        voiceSmsRecognition.onend = () => {
          stopVoiceSmsDictation();
        };

        voiceSmsRecognition.start();
      } catch (err) {
        console.error('SpeechRecognition start failed:', err);
        stopVoiceSmsDictation();
      }
    }

    function stopVoiceSmsDictation() {
      isVoiceSmsRecording = false;
      if (voiceSmsRecognition) {
        try { voiceSmsRecognition.stop(); } catch(e) {}
        voiceSmsRecognition = null;
      }
      const btn = document.getElementById('btn-voice-sms');
      const icon = document.getElementById('voice-sms-icon');
      const badge = document.getElementById('voice-sms-badge');
      const hint = document.getElementById('voice-sms-hint');
      const actions = document.getElementById('voice-sms-actions');

      if (btn) {
        btn.classList.remove('bg-rose-600', 'animate-pulse');
        btn.classList.add('bg-blue-600');
      }
      if (icon) icon.textContent = '🎙️';
      if (badge) badge.classList.add('hidden');
      if (actions) actions.classList.add('hidden');
    }

    function parseAndFillSmsVoice(text) {
      text = text.replace(/^[\\.\\,\\s]+|[\\.\\,\\s]+$/g, '');
      const sepPatterns = [
        /^(?:send\\s+a\\s+text\\s+to|send\\s+text\\s+to|send\\s+an?\\s+sms\\s+to|send\\s+message\\s+to|shoot\\s+a\\s+text\\s+to|text|tell|send|message|sms)\\s+(?:to\\s+)?(.+?)\\s+(?:that|saying|to say|and say)\\s+(.+)$/i,
        /^(?:send\\s+a\\s+text\\s+to|send\\s+text\\s+to|send\\s+an?\\s+sms\\s+to|send\\s+message\\s+to|shoot\\s+a\\s+text\\s+to|text|tell|send|message|sms)\\s+(?:to\\s+)?(.+?)\\s*:\\s*(.+)$/i
      ];
      for (let pat of sepPatterns) {
        const m = text.match(pat);
        if (m) {
          document.getElementById('sms-recipient').value = m[1].trim();
          document.getElementById('sms-message').value = m[2].trim();
          updateSmsCharCount();
          searchAddressBook();
          return;
        }
      }
      const simplePat = /^(?:send\\s+a\\s+text\\s+to|send\\s+text\\s+to|send\\s+an?\\s+sms\\s+to|send\\s+message\\s+to|shoot\\s+a\\s+text\\s+to|text|tell|send|message|sms)\\s+(?:to\\s+)?([a-zA-Z0-9\\+\\-]+)\\s+(.+)$/i;
      const m2 = text.match(simplePat);
      if (m2) {
        document.getElementById('sms-recipient').value = m2[1].trim();
        document.getElementById('sms-message').value = m2[2].trim();
        updateSmsCharCount();
        searchAddressBook();
        return;
      }
      // If user only said recipient name
      const trigOnly = /^(?:send\\s+a\\s+text\\s+to|send\\s+text\\s+to|send\\s+an?\\s+sms\\s+to|send\\s+message\\s+to|shoot\\s+a\\s+text\\s+to|text|tell|send|message|sms)\\s+(?:to\\s+)?(.+)$/i;
      const m3 = text.match(trigOnly);
      if (m3) {
        document.getElementById('sms-recipient').value = m3[1].trim();
        searchAddressBook();
      }
    }

    // ---------- SMS & Contact Messaging Engine ----------
    function updateSmsCharCount() {
      const txt = document.getElementById('sms-message').value || '';
      document.getElementById('sms-char-count').textContent = `${txt.length} chars`;
    }

    function applySmsPreset(text) {
      const box = document.getElementById('sms-message');
      box.value = text;
      updateSmsCharCount();
      box.focus();
    }

    async function searchAddressBook() {
      const query = document.getElementById('sms-recipient').value.trim();
      const container = document.getElementById('contact-matches-box');
      if (!query) {
        container.innerHTML = '<span class="text-amber-400">Type a name above to search contacts.</span>';
        container.classList.remove('hidden');
        return;
      }
      container.innerHTML = '<span class="text-slate-400">Searching macOS address book...</span>';
      container.classList.remove('hidden');
      try {
        const res = await fetch(`/api/contacts?query=${encodeURIComponent(query)}`);
        const data = await res.json();
        if (!data.matches || data.matches.length === 0) {
          container.innerHTML = `<span class="text-rose-400">No contacts matching "${escapeHtml(query)}" found.</span>`;
          return;
        }
        container.innerHTML = `<div class="text-[10px] text-slate-400 uppercase font-bold mb-1">Select Contact (${data.matches.length} found):</div>`;
        data.matches.forEach(m => {
          const btn = document.createElement('button');
          btn.className = 'w-full text-left bg-slate-900 hover:bg-slate-800 p-2 rounded border border-slate-800 flex items-center justify-between transition cursor-pointer mb-1';
          btn.innerHTML = `<span class="font-semibold text-white">${escapeHtml(m.name)}</span><span class="text-sky-400 font-mono text-[11px]">${escapeHtml(m.cleaned || m.phone)}</span>`;
          btn.onclick = () => {
            document.getElementById('sms-recipient').value = m.name;
            container.classList.add('hidden');
          };
          container.appendChild(btn);
        });
      } catch (err) {
        container.innerHTML = `<span class="text-rose-400">Search error: ${escapeHtml(err.message)}</span>`;
      }
    }

    async function sendRemoteSms() {
      const recipient = document.getElementById('sms-recipient').value.trim();
      const message = document.getElementById('sms-message').value.trim();
      const receiptBox = document.getElementById('sms-receipt-box');
      const sendBtn = document.getElementById('btn-send-sms');

      if (!recipient) {
        alert('Please enter a recipient contact name or phone number.');
        return;
      }
      if (!message) {
        alert('Please enter a text message to send.');
        return;
      }

      sendBtn.disabled = true;
      sendBtn.innerHTML = '<span>⏳</span> <span>Dispatching via Messages.app...</span>';
      receiptBox.classList.remove('hidden');
      receiptBox.className = 'mt-4 p-3 rounded-xl border border-blue-500/30 bg-blue-950/40 text-blue-200 text-xs font-mono';
      receiptBox.innerHTML = `Sending to <b>${escapeHtml(recipient)}</b> from Rick Jefferson's iPhone 14...`;

      try {
        const res = await fetch('/api/send-sms', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            recipient: recipient,
            message: message,
            pin: getActivePin()
          })
        });
        const data = await res.json();
        if (res.ok && data.status === 'ok') {
          receiptBox.className = 'mt-4 p-3 rounded-xl border border-emerald-500/40 bg-emerald-950/40 text-emerald-300 text-xs font-mono';
          receiptBox.innerHTML = `
            <div class="font-bold flex items-center gap-1.5 text-emerald-400 mb-1">
              <span>✓</span> <span>SENT SUCCESSFULLY VIA MESSAGES.APP</span>
            </div>
            <div><b>To:</b> ${escapeHtml(data.name)} (${escapeHtml(data.recipient)})</div>
            <div><b>Message:</b> "${escapeHtml(data.message)}"</div>
            <div class="text-[10px] text-emerald-400/80 mt-1">Sender: ${escapeHtml(data.sender)}</div>
          `;
          document.getElementById('sms-message').value = '';
          updateSmsCharCount();
        } else {
          receiptBox.className = 'mt-4 p-3 rounded-xl border border-rose-500/40 bg-rose-950/40 text-rose-300 text-xs font-mono';
          receiptBox.innerHTML = `<b>✗ Send Failed:</b> ${escapeHtml(data.error || data.detail || 'Unknown error')}`;
        }
      } catch (err) {
        receiptBox.className = 'mt-4 p-3 rounded-xl border border-rose-500/40 bg-rose-950/40 text-rose-300 text-xs font-mono';
        receiptBox.innerHTML = `<b>✗ Network Error:</b> ${escapeHtml(err.message)}`;
      } finally {
        sendBtn.disabled = false;
        sendBtn.innerHTML = '<span class="text-base">🚀</span> <span>Dispatch Text via iPhone 14 (+1 945-308-8003)</span>';
      }
    }

    // ---------- Messages Inbox Integration ----------
    async function loadRecentMessages() {
      const box = document.getElementById('inbox-stream-box');
      box.textContent = 'Loading latest incoming SMS and iMessages...';
      try {
        const res = await fetch('/api/messages?limit=15&pin=' + encodeURIComponent(getActivePin()));
        const data = await res.json();
        if (data.status === 'ok') {
          box.textContent = data.output || 'No recent messages.';
        } else {
          box.textContent = 'Failed to load messages: ' + (data.error || 'Unknown error');
        }
      } catch (err) {
        box.textContent = 'Error querying Messages database: ' + err.message;
      }
    }

    async function loadSpamMessages() {
      const box = document.getElementById('inbox-stream-box');
      box.textContent = 'Scanning for spam, phishing, and scam messages...';
      try {
        const res = await fetch('/api/messages?mode=spam&pin=' + encodeURIComponent(getActivePin()));
        const data = await res.json();
        if (data.status === 'ok') {
          box.textContent = data.output || 'No spam detected.';
        } else {
          box.textContent = 'Failed to scan spam: ' + (data.error || 'Unknown error');
        }
      } catch (err) {
        box.textContent = 'Error scanning spam: ' + err.message;
      }
    }

    // ---------- Photo & Storage Actions ----------
    async function runPhotoAction(action) {
      const box = document.getElementById('photos-output-box');
      box.textContent = `Running ${action}...`;
      try {
        const res = await fetch('/api/photos-action', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'X-Apex-PIN': getActivePin()
          },
          body: JSON.stringify({
            action: action,
            pin: getActivePin()
          })
        });
        const data = await res.json();
        if (data.status === 'ok') {
          box.textContent = data.output || 'Action completed.';
        } else {
          box.textContent = 'Error: ' + (data.error || 'Action failed');
        }
      } catch (err) {
        box.textContent = 'Network error: ' + err.message;
      }
    }

    // ---------- Live Status Polling ----------
    async function updateStatus() {
      try {
        const res = await fetch('/api/status');
        const d = await res.json();
        document.getElementById('mac-status-text').textContent = 
          `${d.battery} · ${d.branch} · load ${d.load}`;
      } catch (e) {
        document.getElementById('mac-status-text').textContent = 'Connected';
      }
    }
    setInterval(updateStatus, 15000);
    updateStatus();
  </script>
</body>
</html>
"""


# ---------- Unified Proxy & Voice API Handler ----------
class SovereignRemoteHandler(http.server.BaseHTTPRequestHandler):
    ttyd_port: int = 7681
    pin: str = "749201"

    def do_HEAD(self):
        self.send_response(200)
        self.send_header("Content-Type", "text/html; charset=utf-8")
        self.end_headers()

    def do_GET(self):
        url_parts = urllib.parse.urlparse(self.path)
        path = url_parts.path

        # Forward any /terminal or /terminal/ws request to ttyd
        if path.startswith("/terminal"):
            self.forward_raw_to_ttyd()
            return

        # PWA Web App Manifest
        if path == "/manifest.json":
            self.send_response(200)
            self.send_header("Content-Type", "application/json")
            self.send_header("Access-Control-Allow-Origin", "*")
            self.end_headers()
            manifest = {
                "name": "Apex OS Remote Commander",
                "short_name": "Apex OS",
                "start_url": "/?pin=" + self.pin,
                "display": "standalone",
                "background_color": "#0f172a",
                "theme_color": "#0f172a",
                "icons": [
                    {
                        "src": "https://storage.googleapis.com/msgsndr/qQnxRHDtyx0uydPd5sRl/media/67eb83c5e519ed689430646b.jpeg",
                        "sizes": "192x192 512x512",
                        "type": "image/jpeg"
                    }
                ]
            }
            self.wfile.write(json.dumps(manifest, indent=2).encode("utf-8"))
            return

        # Status endpoint
        if path == "/api/status":
            self.send_response(200)
            self.send_header("Content-Type", "application/json")
            self.send_header("Access-Control-Allow-Origin", "*")
            self.end_headers()

            batt_res = subprocess.run(["pmset", "-g", "batt"], capture_output=True, text=True)
            m_batt = re.search(r"(\d+%);", batt_res.stdout)
            battery = f"🔋 {m_batt.group(1)}" if m_batt else "⚡ AC Power"

            branch_res = subprocess.run(["git", "rev-parse", "--abbrev-ref", "HEAD"], capture_output=True, text=True)
            branch = branch_res.stdout.strip() if branch_res.returncode == 0 else "main"

            load_res = subprocess.run(["uptime"], capture_output=True, text=True)
            m_load = re.search(r"load averages?:\s*([0-9.]+)", load_res.stdout)
            load = m_load.group(1) if m_load else "0.5"

            resp = {"status": "online", "battery": battery, "branch": branch, "load": load}
            self.wfile.write(json.dumps(resp).encode("utf-8"))
            return

        # Keys Status Endpoint
        if path == "/api/keys-status":
            self.send_response(200)
            self.send_header("Content-Type", "application/json")
            self.send_header("Access-Control-Allow-Origin", "*")
            self.end_headers()
            status = {
                "cloudflare": {
                    "connected": bool(os.environ.get("CLOUDFLARE_API_TOKEN")),
                    "account_id": os.environ.get("CLOUDFLARE_ACCOUNT_ID", "58250b56ae5b45d940cd6e4b64314c01"),
                    "status": "active"
                },
                "github": {
                    "connected": bool(os.environ.get("GITHUB_TOKEN")),
                    "username": os.environ.get("GITHUB_USERNAME", "rjbizsolution23-wq"),
                    "status": "authenticated"
                },
                "venice": {
                    "connected": bool(os.environ.get("VENICE_API_KEY")),
                    "model": os.environ.get("VENICE_DEFAULT_MODEL", "zai-org-glm-5-2"),
                    "status": "active"
                },
