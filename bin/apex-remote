        </span>
      </div>

    </section>

  </main>

  <script>
    // ---------- State & Device Pairing ----------
    let isRecording = false;
    let recognition = null;
    let activeTab = 'voice';

    // Auto-save and retrieve PIN from localStorage
    const urlParams = new URLSearchParams(window.location.search);
    const pinFromUrl = urlParams.get('pin');
    if (pinFromUrl) {
      localStorage.setItem('apex_pin', pinFromUrl);
    }
    function getActivePin() {
      return localStorage.getItem('apex_pin') || pinFromUrl || '408100';
    }

    // ---------- Tab Switching ----------
    function switchTab(tabId) {
      activeTab = tabId;
      ['voice', 'terminal', 'actions', 'iphone'].forEach(id => {
        const view = document.getElementById('view-' + id);
        const btn = document.getElementById('tab-' + id);
        if (id === tabId) {
          view.classList.remove('hidden');
          btn.classList.add('bg-blue-600', 'text-white');
          btn.classList.remove('bg-slate-800', 'text-slate-300');
        } else {
          view.classList.add('hidden');
          btn.classList.remove('bg-blue-600', 'text-white');
          btn.classList.add('bg-slate-800', 'text-slate-300');
        }
      });
    }

    // ---------- Speech Recognition (Web Speech API) ----------
    function initSpeech() {
      const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
      if (!SpeechRecognition) {
        document.getElementById('voice-state').textContent = 'Voice recognition not supported in this browser. Use text box.';
        return null;
      }
      const rec = new SpeechRecognition();
      rec.continuous = false;
      rec.interimResults = true;
      rec.lang = 'en-US';

      rec.onstart = () => {
        isRecording = true;
        document.getElementById('mic-button').classList.add('ring-4', 'ring-red-500', 'from-red-600', 'to-rose-400', 'pulse-ring');
        document.getElementById('mic-icon').textContent = '🔴';
        document.getElementById('voice-state').textContent = 'Listening... Speak your command now';
        document.getElementById('voice-waves').classList.remove('opacity-0');
      };

      rec.onresult = (e) => {
        let transcript = '';
        for (let i = 0; i < e.results.length; i++) {
          transcript += e.results[i][0].transcript;
        }
        document.getElementById('task-input').value = transcript;
        document.getElementById('char-count').textContent = transcript.length + ' chars';
      };

      rec.onerror = (e) => {
        console.error('Speech error', e);
        stopRecording();
        document.getElementById('voice-state').textContent = 'Error: ' + e.error + '. Tap to retry.';
      };

      rec.onend = () => {
        stopRecording();
        const text = document.getElementById('task-input').value.trim();
        if (text) {
          document.getElementById('voice-state').textContent = 'Heard: "' + text.substring(0, 40) + '..."';
          executeTask();
        } else {
          document.getElementById('voice-state').textContent = 'Tap to Speak to MacBook';
        }
      };

      return rec;
    }

    function toggleVoiceRecording() {
      if (isRecording) {
        if (recognition) recognition.stop();
        stopRecording();
      } else {
        if (!recognition) recognition = initSpeech();
        if (recognition) {
          try { recognition.start(); } catch(e) { console.warn(e); }
        }
      }
    }

    function stopRecording() {
      isRecording = false;
      const btn = document.getElementById('mic-button');
      btn.classList.remove('ring-4', 'ring-red-500', 'from-red-600', 'to-rose-400', 'pulse-ring');
      btn.classList.add('from-blue-600', 'to-sky-400');
      document.getElementById('mic-icon').textContent = '🎙️';
      document.getElementById('voice-waves').classList.add('opacity-0');
    }

    // ---------- Execute Task via Backend API ----------
    async function executeTask() {
      const task = document.getElementById('task-input').value.trim();
      if (!task) return;

      const model = document.getElementById('model-select').value;
      const yolo = document.getElementById('trust-yolo').checked;
      const audioFeedback = document.getElementById('audio-feedback').checked;
      const pin = getActivePin();

      const logContainer = document.getElementById('execution-logs');
      logContainer.innerHTML += `<div class="text-blue-400 font-bold mt-2">⚡ [Voice Command Dispatched]: "${task}"</div>`;
      logContainer.scrollTop = logContainer.scrollHeight;

      document.getElementById('btn-execute').disabled = true;
      document.getElementById('btn-execute').classList.add('opacity-50');

      try {
        const resp = await fetch('/api/voice-task', {
          method: 'POST',
          headers: { 
            'Content-Type': 'application/json',
            'X-Apex-PIN': pin
          },
          body: JSON.stringify({ task, model, yolo, audio_feedback: audioFeedback, pin })
        });
        const data = await resp.json();

        if (data.status === 'ok') {
          logContainer.innerHTML += `<div class="text-emerald-400 whitespace-pre-wrap mt-1">${escapeHtml(data.output)}</div>`;
          // Phone Speech Synthesis feedback
          if (audioFeedback && 'speechSynthesis' in window) {
            const summary = data.summary || "Task completed on your MacBook.";
            const utter = new SpeechSynthesisUtterance(summary);
            utter.rate = 1.05;
            window.speechSynthesis.speak(utter);
          }
        } else {
          logContainer.innerHTML += `<div class="text-red-400 mt-1">✗ Error: ${escapeHtml(data.error || 'Execution failed')}</div>`;
        }
      } catch (err) {
        logContainer.innerHTML += `<div class="text-red-400 mt-1">✗ Network Error: ${escapeHtml(err.message)}</div>`;
      } finally {
        document.getElementById('btn-execute').disabled = false;
        document.getElementById('btn-execute').classList.remove('opacity-50');
        logContainer.scrollTop = logContainer.scrollHeight;
      }
    }

    function quickRun(prompt, yolo) {
      document.getElementById('task-input').value = prompt;
      document.getElementById('trust-yolo').checked = yolo;
      switchTab('voice');
      executeTask();
    }

    function clearLogs() {
      document.getElementById('execution-logs').innerHTML = '<p class="text-slate-500 italic">Logs cleared.</p>';
    }

    function escapeHtml(str) {
      return (str || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
    }

    // ---------- iPhone & Siri Helpers ----------
    function copyToClipboard(text, btnId) {
      navigator.clipboard.writeText(text).then(() => {
        const btn = document.getElementById(btnId);
        const orig = btn.innerHTML;
        btn.innerHTML = '<span>✓</span> <span>Copied to Clipboard!</span>';
        setTimeout(() => { btn.innerHTML = orig; }, 2500);
      });
    }

    function copySiriWebhook() {
      const url = window.location.origin + '/api/voice-task';
      copyToClipboard(url, 'btn-copy-siri');
    }

    function testSiriDispatch() {
      document.getElementById('task-input').value = "Speak MacBook system status and verify test readiness";
      switchTab('voice');
      executeTask();
    }

    // ---------- Send Key to Embedded ttyd Terminal ----------
    function sendKeyToTerminal(key) {
      const frame = document.getElementById('terminal-frame');
      if (frame && frame.contentWindow) {
        frame.contentWindow.postMessage({ type: 'stdin', data: key }, '*');
      }
    }

    function sendTextToTerminal(text) {
      const frame = document.getElementById('terminal-frame');
      if (frame && frame.contentWindow) {
        frame.contentWindow.postMessage({ type: 'stdin', data: text }, '*');
      }
    }

    // ---------- Live Status Polling ----------
    async function updateStatus() {
      try {
        const res = await fetch('/api/status');
        const d = await res.json();
        document.getElementById('mac-status-text').textContent = 
          `${d.battery} · ${d.branch} · load ${d.load}`;
      } catch (e) {
        document.getElementById('mac-status-text').textContent = 'Connected';
      }
    }
    setInterval(updateStatus, 15000);
    updateStatus();
  </script>
</body>
</html>
"""


# ---------- Unified Proxy & Voice API Handler ----------
class SovereignRemoteHandler(http.server.BaseHTTPRequestHandler):
    ttyd_port: int = 7681
    pin: str = "749201"

    def do_HEAD(self):
        self.send_response(200)
        self.send_header("Content-Type", "text/html; charset=utf-8")
        self.end_headers()

    def do_GET(self):
        url_parts = urllib.parse.urlparse(self.path)
        path = url_parts.path

        # Forward any /terminal or /terminal/ws request to ttyd
        if path.startswith("/terminal"):
            self.forward_raw_to_ttyd()
            return

        # PWA Web App Manifest
        if path == "/manifest.json":
            self.send_response(200)
            self.send_header("Content-Type", "application/json")
            self.send_header("Access-Control-Allow-Origin", "*")
            self.end_headers()
            manifest = {
                "name": "Apex OS Remote Commander",
                "short_name": "Apex OS",
                "start_url": "/?pin=" + self.pin,
                "display": "standalone",
                "background_color": "#0f172a",
                "theme_color": "#0f172a",
                "icons": [
                    {
                        "src": "https://storage.googleapis.com/msgsndr/qQnxRHDtyx0uydPd5sRl/media/67eb83c5e519ed689430646b.jpeg",
                        "sizes": "192x192 512x512",
                        "type": "image/jpeg"
                    }
                ]
            }
            self.wfile.write(json.dumps(manifest, indent=2).encode("utf-8"))
            return

        # Status endpoint
        if path == "/api/status":
            self.send_response(200)
            self.send_header("Content-Type", "application/json")
            self.send_header("Access-Control-Allow-Origin", "*")
            self.end_headers()

            batt_res = subprocess.run(["pmset", "-g", "batt"], capture_output=True, text=True)
            m_batt = re.search(r"(\d+%);", batt_res.stdout)
            battery = f"🔋 {m_batt.group(1)}" if m_batt else "⚡ AC Power"

            branch_res = subprocess.run(["git", "rev-parse", "--abbrev-ref", "HEAD"], capture_output=True, text=True)
            branch = branch_res.stdout.strip() if branch_res.returncode == 0 else "main"

            load_res = subprocess.run(["uptime"], capture_output=True, text=True)
            m_load = re.search(r"load averages?:\s*([0-9.]+)", load_res.stdout)
            load = m_load.group(1) if m_load else "0.5"

            resp = {"status": "online", "battery": battery, "branch": branch, "load": load}
            self.wfile.write(json.dumps(resp).encode("utf-8"))
            return

        # Device Pairing Endpoint
        if path == "/api/device":
            self.send_response(200)
            self.send_header("Content-Type", "application/json")
            self.send_header("Access-Control-Allow-Origin", "*")
            self.end_headers()
            if DEVICE_FILE.exists():
                self.wfile.write(DEVICE_FILE.read_bytes())
            else:
                self.wfile.write(json.dumps({
                    "model": "iPhone 14",
                    "phone": "+1 (945) 308-8003",
                    "status": "PAIRED"
                }).encode("utf-8"))
            return

        # Siri Shortcut Configuration Endpoint
        if path == "/api/shortcut":
            self.send_response(200)
            self.send_header("Content-Type", "application/json")
            self.send_header("Access-Control-Allow-Origin", "*")
            self.end_headers()
            shortcut_info = {
                "name": "Apex Build",
                "trigger": "Hey Siri, Apex Build",
                "url": "https://apex.empirecontentstudios.com/api/voice-task",
                "method": "POST",
                "headers": {"Content-Type": "application/json", "X-Apex-PIN": self.pin},
                "body_format": {
                    "task": "{{Shortcut Input}}",
                    "model": "zai-org-glm-5-2",
                    "yolo": True,
                    "audio_feedback": True,
                    "pin": self.pin
                },
                "voice_reply_key": "summary"
            }
            self.wfile.write(json.dumps(shortcut_info, indent=2).encode("utf-8"))
            return

        # Root: Serve Sovereign Mobile Voice & Remote Dashboard
        self.send_response(200)
        self.send_header("Content-Type", "text/html; charset=utf-8")
        self.end_headers()
        self.wfile.write(DASHBOARD_HTML.encode("utf-8"))

    def do_POST(self):
        url_parts = urllib.parse.urlparse(self.path)
        path = url_parts.path

        if path.startswith("/terminal"):
            self.forward_raw_to_ttyd()
            return

        # Voice task execution endpoint
        if path == "/api/voice-task":
            content_len = int(self.headers.get("Content-Length") or 0)
            body = self.rfile.read(content_len).decode("utf-8")
            data = json.loads(body) if body else {}

            # Optional PIN validation
            req_pin = data.get("pin") or self.headers.get("X-Apex-PIN") or urllib.parse.parse_qs(url_parts.query).get("pin", [""])[0]
            if req_pin and req_pin != self.pin:
                self.send_response(401)
                self.send_header("Content-Type", "application/json")
                self.end_headers()
                self.wfile.write(json.dumps({"status": "error", "error": "Unauthorized PIN"}).encode("utf-8"))
                return

            task = data.get("task", "").strip()
            model = data.get("model", "zai-org-glm-5-2")
            yolo = bool(data.get("yolo", True))
            audio_feedback = bool(data.get("audio_feedback", True))

            if not task:
                self.send_response(400)
                self.send_header("Content-Type", "application/json")
                self.end_headers()
                self.wfile.write(json.dumps({"status": "error", "error": "No task provided"}).encode("utf-8"))
                return

            # Mac Audio Announcement
            if audio_feedback:
                subprocess.Popen(["say", "-v", "Samantha", f"Starting remote voice task: {task[:50]}"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

            # Build apex-agent command line
            agent_bin = pathlib.Path.home() / ".local/bin/apex-agent"
            if not agent_bin.exists():
                agent_bin = pathlib.Path(__file__).resolve().parent / "apex-agent"

            cmd = [sys.executable, str(agent_bin)]
            if yolo:
                cmd.extend(["--trust", "yolo"])
            cmd.extend(["--model", model])
            cmd.append(task)

            # Run apex-agent in workspace dir
            work_dir = os.environ.get("WORKSPACE_DIR") or str(pathlib.Path.home() / "Downloads" / "Super-agents266")
            if not pathlib.Path(work_dir).exists():
                work_dir = str(pathlib.Path.home())
            r = subprocess.run(cmd, capture_output=True, text=True, timeout=180, cwd=work_dir)
            full_output = (r.stdout + r.stderr).strip()

            summary = f"Task completed on your MacBook: {task[:40]}"
            if "✓" in full_output:
                summary = "Build and verification succeeded on your MacBook."
            elif "ERROR" in full_output or "✗" in full_output:
                summary = "Task encountered an error. Check logs on your screen."

            # Announce completion on Mac
            if audio_feedback:
                subprocess.Popen(["say", "-v", "Samantha", summary], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

            self.send_response(200)
            self.send_header("Content-Type", "application/json")
            self.send_header("Access-Control-Allow-Origin", "*")
            self.end_headers()
            self.wfile.write(json.dumps({"status": "ok", "output": full_output, "summary": summary}).encode("utf-8"))
            return

        self.send_response(404)
        self.end_headers()

    def forward_raw_to_ttyd(self):
        """Bridges HTTP and WebSockets seamlessly between client and ttyd with auto-auth."""
        try:
            upstream = socket.create_connection(("127.0.0.1", self.ttyd_port), timeout=10)
        except Exception as e:
            self.send_response(502)
            self.send_header("Content-Type", "text/plain")
            self.end_headers()
            self.wfile.write(f"ttyd upstream unavailable: {e}".encode("utf-8"))
            return

        req_lines = [f"{self.command} {self.path} {self.request_version}"]
        has_auth = False
        for k, v in self.headers.items():
            if k.lower() == "authorization":
                has_auth = True
            req_lines.append(f"{k}: {v}")

        # Inject basic auth so the user never gets prompted on mobile
        if not has_auth and self.pin:
            token = base64.b64encode(f"rick:{self.pin}".encode("utf-8")).decode("ascii")
            req_lines.append(f"Authorization: Basic {token}")

        req_bytes = "\r\n".join(req_lines).encode("utf-8") + b"\r\n\r\n"
        upstream.sendall(req_bytes)

        client_sock = self.connection
        sockets = [client_sock, upstream]
        try:
            while True:
                r, _, _ = select.select(sockets, [], [], 120.0)
                if not r:
                    break
                for s in r:
                    other = upstream if s is client_sock else client_sock
                    data = s.recv(16384)
                    if not data:
                        return
                    other.sendall(data)
        except Exception:
            pass
        finally:
            upstream.close()


# ---------- Cloudflare Tunnel Runner ----------
def start_cloudflare_tunnel(port: int) -> Tuple[subprocess.Popen, str]:
    cloudflared_bin = shutil.which("cloudflared") or "/opt/homebrew/bin/cloudflared"
    proc = subprocess.Popen(
        [cloudflared_bin, "tunnel", "--url", f"http://localhost:{port}"],
        stderr=subprocess.PIPE,
        stdout=subprocess.DEVNULL,
        text=True,
    )
    public_url = ""
    t0 = time.time()
    while time.time() - t0 < 20:
        line = proc.stderr.readline()
        if not line:
            time.sleep(0.1)
            continue
        m = re.search(r"https://[a-zA-Z0-9-]+\.trycloudflare\.com", line)
        if m:
            public_url = m.group(0)
            break
    return proc, public_url


# ---------- Main CLI Entrypoint ----------
def main() -> None:
    parser = argparse.ArgumentParser(description="Apex Remote & Voice Command Gateway")
    parser.add_argument("--port", type=int, default=7795, help="Remote Gateway port (default: 7795)")
    parser.add_argument("--ttyd-port", type=int, default=7681, help="ttyd terminal port (default: 7681)")
    parser.add_argument("--pin", type=str, default="", help="Remote PIN credential")
    parser.add_argument("--local-only", action="store_true", help="Skip Cloudflare public tunnel")
    args = parser.parse_args()

    # Determine PIN
    pin = args.pin
    if not pin:
        if AUTH_FILE.exists():
            pin = AUTH_FILE.read_text().strip()
        else:
            pin = str(random.randint(100000, 999999))
            AUTH_FILE.parent.mkdir(parents=True, exist_ok=True)
            AUTH_FILE.write_text(pin)

    # 1. Start ttyd
    ttyd_bin = shutil.which("ttyd") or "/opt/homebrew/bin/ttyd"
    print("\033[1;36m╭─ 🌐 STARTING APEX REMOTE & SOVEREIGN VOICE COMMAND CENTER\033[0m")
    print(f"\033[1;34m├─ 🖥️  Launching ttyd Terminal on :7681 (user: rick | PIN: {pin})\033[0m")
    
    # Kill any stale ttyd on this port
    subprocess.run(["pkill", "-f", f"ttyd.*{args.ttyd_port}"], capture_output=True)
    time.sleep(0.3)

    work_dir = os.environ.get("WORKSPACE_DIR") or str(pathlib.Path.home() / "Downloads" / "Super-agents266")
    if not pathlib.Path(work_dir).exists():
        work_dir = str(pathlib.Path.home())

    ttyd_proc = subprocess.Popen(
        [ttyd_bin, "-W", "-b", "/terminal", "-p", str(args.ttyd_port), "-c", f"rick:{pin}", "-w", work_dir, "zsh"],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )
    time.sleep(0.5)

    # 2. Start Gateway Server on 7795
    socketserver.ThreadingTCPServer.allow_reuse_address = True
    SovereignRemoteHandler.ttyd_port = args.ttyd_port
    SovereignRemoteHandler.pin = pin
    server = socketserver.ThreadingTCPServer(("0.0.0.0", args.port), SovereignRemoteHandler)
    server_thread = threading.Thread(target=server.serve_forever)
    server_thread.daemon = True
    server_thread.start()

    local_url = f"http://localhost:{args.port}?pin={pin}"
    public_url = ""
    tunnel_proc = None

    if not args.local_only:
        print(f"\033[1;35m├─ 🔒 Spawning Cloudflare Zero Trust Public Tunnel...\033[0m")
        tunnel_proc, public_url = start_cloudflare_tunnel(args.port)

    active_url = public_url if public_url else local_url

    print(f"\033[1;32m├─ 📱 Active Gateway URL:\033[0m \033[1;37;44m {active_url} \033[0m")
    print(f"\033[1;33m├─ 🔑 Remote Credentials:\033[0m Username: \033[1;37mrick\033[0m | PIN: \033[1;37m{pin}\033[0m")
    print(f"\033[1;36m├─ 🎙️  Voice Intelligence:\033[0m Web Speech + Dual SpeechSynthesis + Mac /usr/bin/say")

    # Copy to clipboard
    subprocess.run(["pbcopy"], input=active_url.encode("utf-8"), check=False)
    print("\033[1;32m├─ 📋 Copied Remote URL to macOS clipboard!\033[0m")

    # Print ASCII QR Code
    if shutil.which("qrencode"):
        print("\033[1;35m╰─ 📲 SCAN QR CODE WITH YOUR IPHONE / IPAD CAMERA TO CONNECT:\033[0m\n")
        subprocess.run(["qrencode", "-t", "UTF8", active_url])
        print("")
    else:
        print(f"\033[1;35m╰─ 📲 Open on your phone: {active_url}\033[0m\n")

    # Voice announcement on Mac
    subprocess.Popen(["say", "-v", "Samantha", "Apex Remote and Voice Command Center is live. Ready for remote build."], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    try:
        while True:
            time.sleep(1)
    except KeyboardInterrupt:
        print("\n\033[1;31mShutting down Apex Remote Gateway...\033[0m")
        if tunnel_proc:
            tunnel_proc.terminate()
        ttyd_proc.terminate()
        server.shutdown()
        print("✓ Done.")


if __name__ == "__main__":
    main()
