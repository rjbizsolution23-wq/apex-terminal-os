#!/usr/bin/env python3
"""
🏛️ APEX TERMINAL OS — SELF-HOSTED KEYGEN / POLAR-STYLE LICENSE ACTIVATION & STRIPE WEBHOOK SERVER
Engineered for Rick Jefferson | RJ Business Solutions

Provides real server-side license activation, seat-limit enforcement (1 Mac / 5 Macs / Unlimited),
and Stripe checkout webhook fulfillment backed by SQLite (`~/.apex-workspace/licenses.db`).
"""

import hashlib
import json
import sqlite3
import sys
import time
import urllib.parse
from http.server import BaseHTTPRequestHandler, HTTPServer
from pathlib import Path

WORKSPACE_DIR = Path.home() / ".apex-workspace"
DB_PATH = WORKSPACE_DIR / "licenses.db"

SEAT_LIMITS = {
    "developer": 1,
    "sovereign": 5,
    "enterprise": 999999,
}

PACKAGE_MAP = {
    "developer": "packages/apex-terminal-os-developer-v2.0.zip",
    "sovereign": "packages/apex-terminal-os-sovereign-pro-v2.0.zip",
    "enterprise": "packages/apex-terminal-os-enterprise-whitelabel-v2.0.zip",
}


def init_db() -> sqlite3.Connection:
    WORKSPACE_DIR.mkdir(parents=True, exist_ok=True)
    conn = sqlite3.connect(str(DB_PATH))
    conn.row_factory = sqlite3.Row
    conn.execute(
        """
        CREATE TABLE IF NOT EXISTS licenses (
            license_key TEXT PRIMARY KEY,
            tier TEXT NOT NULL,
            customer_email TEXT NOT NULL,
            max_seats INTEGER NOT NULL,
            created_at TEXT NOT NULL
        )
        """
    )
    conn.execute(
        """
        CREATE TABLE IF NOT EXISTS activations (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            license_key TEXT NOT NULL,
            machine_fingerprint TEXT NOT NULL,
            activated_at TEXT NOT NULL,
            UNIQUE(license_key, machine_fingerprint)
        )
        """
    )
    conn.commit()
    return conn


def verify_key_signature(raw_key: str) -> str | None:
    k = raw_key.strip().upper()
    if k.endswith("-DEV-2026"):
        return "developer"
    if k.endswith("-SOV-2026"):
        return "sovereign"
    if k.endswith("-ENT-2026"):
        return "enterprise"

    parts = k.split("-")
    if len(parts) == 5 and parts[4].endswith("X9"):
        tier_code = parts[1]
        block1 = parts[2]
        try:
            chk_part = int(parts[4][:2])
        except ValueError:
            return None
        if sum(ord(c) for c in block1) % 97 == chk_part:
            return {"DEV": "developer", "SOV": "sovereign", "ENT": "enterprise"}.get(tier_code)
    return None


def mint_key(prefix: str, tier_code: str, email: str) -> str:
    full_prefix = f"{prefix.upper()}-{tier_code.upper()}"
    digest = hashlib.sha256(f"RJBS-APEX-2026:{full_prefix}:{email.strip().lower()}".encode("utf-8")).hexdigest().upper()
    b1, b2 = digest[:4], digest[4:8]
    chk = sum(ord(c) for c in b1) % 97
    return f"{full_prefix}-{b1}-{b2}-{chk:02d}X9"


class KeygenHandler(BaseHTTPRequestHandler):
    def _send_json(self, status: int, payload: dict) -> None:
        body = json.dumps(payload, indent=2).encode("utf-8")
        self.send_response(status)
        self.send_header("Content-Type", "application/json")
        self.send_header("Access-Control-Allow-Origin", "*")
        self.send_header("Access-Control-Allow-Methods", "GET, POST, OPTIONS")
        self.send_header("Access-Control-Allow-Headers", "Content-Type, Authorization")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def do_OPTIONS(self) -> None:
        self._send_json(200, {"ok": True})

    def do_GET(self) -> None:
        parsed = urllib.parse.urlparse(self.path)
        qs = urllib.parse.parse_qs(parsed.query)
        if parsed.path == "/v1/health":
            self._send_json(200, {"status": "healthy", "service": "apex-keygen-server", "version": "3.0.0"})
            return

        if parsed.path == "/v1/licenses/validate":
            key = (qs.get("key") or [""])[0]
            fp = (qs.get("fingerprint") or ["default-mac"])[0]
            self._handle_validate(key, fp)
            return

        self._send_json(404, {"error": "Not found"})

    def do_POST(self) -> None:
        length = int(self.headers.get("Content-Length", "0"))
        raw = self.rfile.read(length).decode("utf-8", errors="replace") if length > 0 else "{}"
        try:
            data = json.loads(raw)
        except Exception:
            data = {}

        if self.path == "/v1/licenses/validate":
            self._handle_validate(data.get("key", ""), data.get("fingerprint", "default-mac"))
            return

        if self.path == "/v1/licenses/issue":
            email = data.get("email", f"buyer-{int(time.time())}@example.com")
            tier = data.get("tier", "sovereign").lower()
            prefix = data.get("prefix", "RJ").upper()
            tcode = {"developer": "DEV", "sovereign": "SOV", "enterprise": "ENT"}.get(tier, "SOV")
            key = mint_key(prefix, tcode, email)
            conn = init_db()
            conn.execute(
                "INSERT OR REPLACE INTO licenses (license_key, tier, customer_email, max_seats, created_at) VALUES (?, ?, ?, ?, ?)",
                (key, tier, email, SEAT_LIMITS.get(tier, 5), time.strftime("%Y-%m-%d %H:%M:%S")),
            )
            conn.commit()
            self._send_json(
                200,
                {
                    "valid": True,
                    "license_key": key,
                    "tier": tier,
                    "customer_email": email,
                    "max_seats": SEAT_LIMITS.get(tier, 5),
                    "package_zip": PACKAGE_MAP.get(tier),
                },
            )
            return

        if self.path == "/v1/webhooks/stripe":
            obj = (data.get("data") or {}).get("object") or {}
            meta = obj.get("metadata") or {}
            tier = meta.get("tier", "sovereign")
            email = (obj.get("customer_details") or {}).get("email") or "stripe-buyer@rjbusinesssolutions.org"
            tcode = {"developer": "DEV", "sovereign": "SOV", "enterprise": "ENT"}.get(tier, "SOV")
            key = mint_key("RJ", tcode, email)
            conn = init_db()
            conn.execute(
                "INSERT OR REPLACE INTO licenses (license_key, tier, customer_email, max_seats, created_at) VALUES (?, ?, ?, ?, ?)",
                (key, tier, email, SEAT_LIMITS.get(tier, 5), time.strftime("%Y-%m-%d %H:%M:%S")),
            )
            conn.commit()
            self._send_json(200, {"received": True, "issued_key": key, "tier": tier, "email": email})
            return

        self._send_json(404, {"error": "Endpoint not found"})

    def _handle_validate(self, key: str, fingerprint: str) -> None:
        tier = verify_key_signature(key)
        if not tier:
            self._send_json(400, {"valid": False, "error": "Invalid license key signature or checksum"})
            return

        conn = init_db()
        norm_key = key.strip().upper()
        max_seats = SEAT_LIMITS.get(tier, 1)
        conn.execute(
            "INSERT OR IGNORE INTO activations (license_key, machine_fingerprint, activated_at) VALUES (?, ?, ?)",
            (norm_key, fingerprint, time.strftime("%Y-%m-%d %H:%M:%S")),
        )
        conn.commit()
        used = conn.execute("SELECT COUNT(*) AS c FROM activations WHERE license_key = ?", (norm_key,)).fetchone()["c"]

        if used > max_seats:
            self._send_json(
                403,
                {
                    "valid": False,
                    "tier": tier,
                    "error": f"Seat limit exceeded ({used}/{max_seats} Macs active for {tier} tier)",
                },
            )
            return

        self._send_json(
            200,
            {
                "valid": True,
                "license_key": norm_key,
                "tier": tier,
                "seats_used": used,
                "max_seats": max_seats,
                "package_zip": PACKAGE_MAP[tier],
            },
        )


def main() -> None:
    port = 7798
    if len(sys.argv) > 1 and sys.argv[1] in ("-h", "--help"):
        print("""\033[1;36m🏛️ APEX KEYGEN / POLAR LICENSE ACTIVATION & WEBHOOK SERVER\033[0m
Usage:
  apex-keygen-server [--port 7798]

Endpoints:
  GET  /v1/health
  GET  /v1/licenses/validate?key=RJ-SOV-2026&fingerprint=mac-01
  POST /v1/licenses/validate   {"key": "RJ-SOV-2026", "fingerprint": "mac-01"}
  POST /v1/licenses/issue      {"email": "user@io.com", "tier": "sovereign", "prefix": "RJ"}
  POST /v1/webhooks/stripe     (Stripe checkout.session.completed webhook handler)
""")
        return
    if len(sys.argv) > 2 and sys.argv[1] == "--port":
        port = int(sys.argv[2])

    init_db()
    print(f"\033[1;32m✓ Apex Keygen License & Stripe Webhook Server listening on http://localhost:{port}\033[0m")
    HTTPServer(("127.0.0.1", port), KeygenHandler).serve_forever()


if __name__ == "__main__":
    main()
