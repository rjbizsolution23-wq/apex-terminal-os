ENV_FILE = pathlib.Path.home() / ".apex-workspace" / ".env"
if ENV_FILE.exists():
    for _line in ENV_FILE.read_text(encoding="utf-8", errors="replace").splitlines():
        _line = _line.strip()
        if _line.startswith("export "):
            _line = _line[7:].strip()
        if _line and not _line.startswith("#") and "=" in _line:
            _k, _v = _line.split("=", 1)
            os.environ.setdefault(_k.strip(), _v.strip().strip('"').strip("'"))


# ---------- Multi-Provider Failover Chain ----------
def build_provider_chain(requested_model: str = "") -> List[Tuple[str, str, str, str]]:
    venice_key = os.environ.get("VENICE_API_KEY", "")
    zai_key = os.environ.get("Z_AI_API_KEY", "c5c2fd9ce8ea4fc7b3efadfdbf43f698.b1U1tW9t9oIdb37f")
    or_key = os.environ.get("OPENROUTER_API_KEY", "")
    v_model = (
        requested_model
        if (requested_model and requested_model != "ollama")
        else os.environ.get("VENICE_MODEL", "zai-org-glm-5-2")
    )
    ollama_model = os.environ.get("OLLAMA_MODEL", "qwen2.5-coder:14b")

    if requested_model == "ollama":
        return [("Ollama Local ($0)", "http://localhost:11434/v1/chat/completions", "", ollama_model)]

    chain: List[Tuple[str, str, str, str]] = []
    if os.environ.get("LITELLM_PROXY_URL"):
        chain.append(
            (
                "LiteLLM Gateway",
                f"{os.environ['LITELLM_PROXY_URL'].rstrip('/')}/chat/completions",
                os.environ.get("LITELLM_API_KEY", venice_key),
                v_model,
            )
        )
    if venice_key:
        chain.append(("Venice AI", "https://api.venice.ai/api/v1/chat/completions", venice_key, v_model))
    if zai_key:
        chain.append(("Sovereign GLM", "https://open.bigmodel.cn/api/paas/v4/chat/completions", zai_key, "glm-4.5-flash"))
    if or_key:
        chain.append(("OpenRouter", "https://openrouter.ai/api/v1/chat/completions", or_key, "cohere/north-mini-code:free"))
    chain.append(("Ollama Local ($0)", "http://localhost:11434/v1/chat/completions", "", ollama_model))
    return chain


# ---------- Sovereign macOS SMS & Contacts Integration ----------
def clean_phone_number(raw: str) -> str:
    """Normalize phone numbers to E.164 international format (+1XXXXXXXXXX for US)."""
    digits = re.sub(r"[^\d+]", "", raw.strip())
    if digits.startswith("+"):
        return digits
    if len(digits) == 11 and digits.startswith("1"):
        return "+" + digits
    if len(digits) == 10:
        return "+1" + digits
    return "+" + digits if digits else ""


def find_contacts(query: str) -> List[Tuple[str, str]]:
    """Query macOS Contacts.app via AppleScript for matching names and phone numbers."""
    safe_query = query.replace('\\', '\\\\').replace('"', '\\"')
    script = f'''
    tell application "Contacts"
        set pList to (people whose name contains "{safe_query}")
        set outList to {{}}
        repeat with p in pList
            set pName to name of p
            repeat with ph in phones of p
                set end of outList to (pName & "|" & (value of ph))
            end repeat
        end repeat
        return outList
    end tell
    '''
    res = subprocess.run(["osascript", "-e", script], capture_output=True, text=True)
    if res.returncode != 0 or not res.stdout.strip():
        return []
    results = []
    entries = [e.strip() for e in res.stdout.strip().split(", ")]
    for entry in entries:
        if "|" in entry:
            name, phone = entry.split("|", 1)
            results.append((name.strip(), phone.strip()))
    return results


def send_imessage(recipient_phone: str, message: str) -> Tuple[bool, str]:
    """Dispatch an iMessage or SMS via macOS Messages.app from Rick's phone number."""
    safe_msg = message.replace('\\', '\\\\').replace('"', '\\"')
    script = f'''
    tell application "Messages"
        try
            set s to 1st service whose service type is iMessage
            set b to buddy "{recipient_phone}" of s
            send "{safe_msg}" to b
            return "OK"
        on error err
            return "ERROR: " & err
        end try
    end tell
    '''
    res = subprocess.run(["osascript", "-e", script], capture_output=True, text=True)
    out = res.stdout.strip()
    if "OK" in out:
        return True, "Delivered via macOS Messages.app"
    return False, out or res.stderr.strip() or "Failed to send message"


