# Tools safe to execute concurrently in parallel threads
READ_ONLY_TOOLS = {
    "read_file",
    "grep_code",
    "find_files",
    "list_dir",
    "git_diff_patch",
    "fetch_web",
    "semantic_search_memory",
    "search_contacts",
}


# ---------- Tool Implementations ----------
def execute_single_tool(name: str, args: Dict[str, Any], trust: str, allow_cmds: List[str]) -> str:
    try:
        if name == "read_file":
            p = pathlib.Path(args["path"])
            if not p.exists():
                return f"ERROR: file '{args['path']}' does not exist"
            if p.is_dir():
                return f"ERROR: '{args['path']}' is a directory, use list_dir instead"
            offset = int(args.get("offset") or 0)
            limit = int(args.get("limit") or 20000)
            content = p.read_text(encoding="utf-8", errors="replace")
            total_size = len(content)
            lines = content.splitlines()
            slice_data = content[offset : offset + limit]
            return f"[{p.name} | total_bytes={total_size} | total_lines={len(lines)} | reading {offset}..{offset + len(slice_data)}]\n{slice_data}"

        elif name == "write_file":
            p = pathlib.Path(args["path"])
            p.parent.mkdir(parents=True, exist_ok=True)
            p.write_text(args["content"], encoding="utf-8")
            return f"✓ wrote {args['path']} ({len(args['content'])} bytes)"

        elif name == "edit_file":
            p = pathlib.Path(args["path"])
            if not p.exists():
                return f"ERROR: file '{args['path']}' does not exist"
            t = p.read_text(encoding="utf-8", errors="replace")
            old_str = args["old"]
            new_str = args["new"]
            if old_str not in t:
                return f"ERROR: target substring not found in {args['path']}. Verify exact whitespace and indentation."
            count = t.count(old_str)
            p.write_text(t.replace(old_str, new_str, 1), encoding="utf-8")
            extra = f" (Warning: string occurred {count} times, replaced first)" if count > 1 else ""
            return f"✓ edited {args['path']}{extra}"

        elif name == "list_dir":
            root = pathlib.Path(args.get("path") or ".")
            max_depth = int(args.get("depth") or 3)
            if not root.exists():
                return f"ERROR: directory '{root}' does not exist"
            out = []
            root_depth = len(root.resolve().parts)
            for p in sorted(root.rglob("*")):
                cur_depth = len(p.resolve().parts) - root_depth
                if cur_depth > max_depth:
                    continue
                p_str = str(p)
                if any(x in p_str for x in (".git", "node_modules", "__pycache__", ".venv", ".DS_Store", "dist", "build")):
                    continue
                kind = "📁 " if p.is_dir() else "📄 "
                out.append(f"{'  ' * (cur_depth - 1)}{kind}{p.name}")
                if len(out) >= 300:
                    out.append("... [truncated at 300 items]")
                    break
            return "\n".join(out) or "(empty directory)"

        elif name == "grep_code":
            query = args["query"]
            path = args.get("path") or "."
            file_pattern = args.get("file_pattern") or "*"
            case_sensitive = bool(args.get("case_sensitive", False))

            rg_bin = shutil.which("rg")
            if rg_bin:
                cmd = [rg_bin, "-n", "--max-columns", "200", "--max-count", "100"]
                if not case_sensitive:
                    cmd.append("-i")
                if file_pattern and file_pattern != "*":
                    cmd.extend(["-g", file_pattern])
                cmd.extend([query, path])
                r = subprocess.run(cmd, capture_output=True, text=True, timeout=30)
                res = r.stdout.strip()
                return res[:12000] if res else "(no matches found with ripgrep)"
            else:
                matches = []
                regex = re.compile(query if case_sensitive else query, 0 if case_sensitive else re.IGNORECASE)
                p_root = pathlib.Path(path)
                for f in p_root.rglob(file_pattern):
                    if not f.is_file():
                        continue
                    if any(x in str(f) for x in (".git", "node_modules", "__pycache__", ".venv", "dist", "build")):
                        continue
                    try:
                        for idx, line in enumerate(f.read_text(encoding="utf-8", errors="replace").splitlines(), 1):
                            if regex.search(line):
                                matches.append(f"{f}:{idx}: {line.strip()[:180]}")
                                if len(matches) >= 100:
                                    break
                    except Exception:
                        pass
                    if len(matches) >= 100:
                        break
                return "\n".join(matches) if matches else "(no matches found)"

        elif name == "find_files":
            pattern = args["pattern"]
            path = pathlib.Path(args.get("path") or ".")
            if not path.exists():
                return f"ERROR: path '{path}' does not exist"
            found = []
            for p in sorted(path.rglob(pattern)):
                p_str = str(p)
                if any(x in p_str for x in (".git", "node_modules", "__pycache__", ".venv", "dist", "build")):
                    continue
                found.append(p_str)
                if len(found) >= 150:
                    found.append("... [truncated at 150 files]")
                    break
            return "\n".join(found) if found else f"(no files matching '{pattern}')"

        elif name == "git_diff_patch":
            staged = bool(args.get("staged", False))
            status_res = subprocess.run(["git", "status", "--short"], capture_output=True, text=True, timeout=15)
            diff_cmd = ["git", "diff", "--cached"] if staged else ["git", "diff"]
            diff_res = subprocess.run(diff_cmd, capture_output=True, text=True, timeout=30)
            st_text = status_res.stdout.strip() or "(working tree clean)"
            df_text = diff_res.stdout.strip() or "(no diff)"
            return f"--- GIT STATUS ---\n{st_text}\n\n--- GIT DIFF ({'STAGED' if staged else 'UNSTAGED'}) ---\n{df_text[:14000]}"

        elif name == "fetch_web":
            url = args["url"]
            max_chars = int(args.get("max_chars") or 12000)
            req = urllib.request.Request(
                url,
                headers={
                    "User-Agent": "Mozilla/5.0 (Macintosh; Intel Mac OS X 10_15_7) ApexTerminalOS/3.0",
                    "Accept": "text/html,application/json,text/plain;q=0.9,*/*;q=0.8",
                },
            )
            with urllib.request.urlopen(req, timeout=25) as resp:
                raw = resp.read().decode("utf-8", errors="replace")
                cleaned = re.sub(r"<script.*?</script>", "", raw, flags=re.DOTALL | re.IGNORECASE)
                cleaned = re.sub(r"<style.*?</style>", "", cleaned, flags=re.DOTALL | re.IGNORECASE)
                cleaned = re.sub(r"<[^>]+>", " ", cleaned)
                cleaned = html.unescape(cleaned)
                cleaned = re.sub(r"\s+", " ", cleaned).strip()
                return cleaned[:max_chars]

        elif name == "run_shell":
            cmd = args["cmd"]
            timeout_sec = int(args.get("timeout") or 120)
            is_allowed = trust == "yolo" or any(cmd.strip().startswith(ac) for ac in allow_cmds)
            if not is_allowed:
                print(f"\033[33m  ⚡ Shell Command: $ {cmd}\033[0m")
                ans = input("  Run? [y/N/a=always allow in session] ").strip().lower()
                if ans == "a":
                    allow_cmds.append(cmd.strip().split()[0])
                elif ans != "y":
                    return "user denied command execution"
            r = subprocess.run(cmd, shell=True, capture_output=True, text=True, timeout=timeout_sec)
            out = r.stdout[-8000:] if r.stdout else ""
            err = r.stderr[-4000:] if r.stderr else ""
            return f"exit={r.returncode}\n{out}{err}"

        elif name == "run_applescript":
            script = args["script"]
            if trust != "yolo":
                print(f"\033[33m  🍎 AppleScript: {script}\033[0m")
                if input("  Run AppleScript? [y/N] ").strip().lower() != "y":
                    return "user denied applescript"
            r = subprocess.run(["osascript", "-e", script], capture_output=True, text=True, timeout=30)
            return f"exit={r.returncode}\n{r.stdout}{r.stderr}"

        elif name == "remember_insight":
            mem_db = pathlib.Path.home() / ".apex-workspace" / "memory.db"
            mem_db.parent.mkdir(parents=True, exist_ok=True)
            conn = sqlite3.connect(str(mem_db))
            conn.execute(
                "CREATE TABLE IF NOT EXISTS agent_memories (id INTEGER PRIMARY KEY AUTOINCREMENT, created_at TEXT, tag TEXT, content TEXT)"
            )
            now = datetime.datetime.now().isoformat()
            conn.execute(
                "INSERT INTO agent_memories (created_at, tag, content) VALUES (?, ?, ?)",
                (now, args["key"], args["insight"]),
            )
            conn.commit()
            return f"✓ Stored persistent memory tagged '{args['key']}' in SQLite"

        elif name == "semantic_search_memory":
            query = args["query"].lower()
            mem_db = pathlib.Path.home() / ".apex-workspace" / "memory.db"
            if not mem_db.exists():
                return "(no persistent memory database found)"
            conn = sqlite3.connect(str(mem_db))
            rows = conn.execute(
                "SELECT tag, content, created_at FROM agent_memories WHERE lower(tag) LIKE ? OR lower(content) LIKE ? ORDER BY id DESC LIMIT 10",
                (f"%{query}%", f"%{query}%"),
            ).fetchall()
            if not rows:
                return f"(no stored memories matching '{query}')"
            return "\n".join(f"• [{r[0]} | {r[2][:10]}] {r[1]}" for r in rows)

        elif name == "spawn_parallel_workers":
            subtasks = args.get("subtasks") or []
            max_workers = min(len(subtasks), int(args.get("max_workers") or 4))
            if not subtasks:
                return "ERROR: no subtasks provided"
            print(f"\n\033[1;35m  ⚡ [PARALLEL SWARM] Spawning {len(subtasks)} worker agents concurrently...\033[0m")

            results = {}
            with concurrent.futures.ThreadPoolExecutor(max_workers=max_workers) as pool:
                def _staggered_worker(st: str, idx: int) -> Tuple[int, str, str]:
                    time.sleep(idx * 0.8)  # Stagger initial requests to avoid concurrent 429 burst
                    res = run_subagent_worker(st, trust, allow_cmds, idx)
                    return idx, st, res

                future_map = {
                    pool.submit(_staggered_worker, st, idx + 1): (idx + 1, st)
                    for idx, st in enumerate(subtasks)
                }
                for fut in concurrent.futures.as_completed(future_map):
                    idx, st = future_map[fut]
                    try:
                        w_idx, _, res = fut.result()
                        results[w_idx] = (st, res)
                        print(f"\033[1;32m  ✓ Worker #{w_idx} completed successfully\033[0m")
                    except Exception as e:
                        results[idx] = (st, f"WORKER_ERROR: {e}")
                        print(f"\033[1;31m  ✗ Worker #{idx} failed: {e}\033[0m")

            summary = ["=== PARALLEL SWARM EXECUTION REPORT ==="]
            for idx in sorted(results.keys()):
                st, r_text = results[idx]
                summary.append(f"\n--- Worker #{idx}: {st} ---\n{r_text}")
            return "\n".join(summary)

        elif name == "search_contacts":
            query = args["query"]
            matches = find_contacts(query)
            if not matches:
                return f"No contacts found in macOS address book matching '{query}'"
            out = [f"Found {len(matches)} contact(s) for '{query}':"]
            for idx, (cname, ph) in enumerate(matches, 1):
                out.append(f"{idx}. {cname} -> {clean_phone_number(ph)} (raw: {ph})")
            return "\n".join(out)

        elif name == "send_sms":
            recipient = args["recipient"]
            msg = args["message"]
            target_phone = clean_phone_number(recipient)
            target_name = recipient
            if not re.search(r"^\+?[\d\s\-\(\)\.]{7,20}$", recipient):
                matches = find_contacts(recipient)
                if matches:
                    target_name, raw_ph = matches[0]
                    target_phone = clean_phone_number(raw_ph)
                else:
                    return f"ERROR: Could not resolve contact '{recipient}' in macOS Contacts and it is not a valid phone number."

            if trust != "yolo":
                print(f"\033[33m  📱 SMS / iMessage to {target_name} ({target_phone}): \"{msg}\"\033[0m")
                if input("  Send text? [y/N] ").strip().lower() != "y":
                    return "user denied SMS transmission"

            ok, detail = send_imessage(target_phone, msg)
            if ok:
                return f"✓ SMS/iMessage successfully sent to {target_name} ({target_phone}) from Rick's number (+1 945-308-8003): \"{msg}\""
            else:
                return f"ERROR sending text to {target_name} ({target_phone}): {detail}"

    except Exception as e:
        return f"TOOL_ERROR in {name}: {e}"

    return "unknown tool"


def run_subagent_worker(subtask: str, trust: str, allow_cmds: List[str], worker_id: int) -> str:
    """Isolated worker agent running a bounded subtask loop."""
    worker_sysm = (
        f"You are Worker #{worker_id} in the Apex Terminal OS Swarm. "
        "Your subtask is strictly bounded. Complete it cleanly and verify your work. "
        "Use tools (read_file, edit_file, write_file, run_shell, grep_code, list_dir, find_files). "
        "Conclude with a clear summary of modifications and test results."
    )
    worker_msgs = [{"role": "system", "content": worker_sysm}, {"role": "user", "content": subtask}]
    model = os.environ.get("VENICE_MODEL", "zai-org-glm-5-2")

    for _ in range(12):
        msg = chat(worker_msgs, model, use_tools=True)
        worker_msgs.append(msg)
        t_calls = msg.get("tool_calls") or []
        if not t_calls:
            return msg.get("content") or "(Worker completed with no additional output)"
        for tc in t_calls:
            fn = tc["function"]["name"]
            raw_a = tc["function"].get("arguments") or "{}"
            a = json.loads(raw_a) if isinstance(raw_a, str) else raw_a
            if fn == "spawn_parallel_workers":
                res = "ERROR: nested swarm spawning not permitted"
            else:
                res = execute_single_tool(fn, a, trust, allow_cmds)
            worker_msgs.append({"role": "tool", "tool_call_id": tc["id"], "content": res[:8000]})

    return "Worker reached maximum step budget (12 steps)."


# ---------- Context Injection ----------
def context_files() -> str:
    """Claude Code reads CLAUDE.md; OpenCode/Codex read AGENTS.md; we read BOTH + persistent SQLite memory."""
    out = []
    for f in ("AGENTS.md", "CLAUDE.md", ".apexagent"):
        if os.path.isfile(f):
            out.append(f"--- {f} ---\n" + pathlib.Path(f).read_text(encoding="utf-8", errors="replace")[:4000])

    mem_db = pathlib.Path.home() / ".apex-workspace" / "memory.db"
    if mem_db.exists():
        try:
            conn = sqlite3.connect(str(mem_db))
            rows = conn.execute("SELECT tag, content FROM agent_memories ORDER BY id DESC LIMIT 6").fetchall()
            if rows:
                out.append("--- PERSISTENT SESSION MEMORIES ---\n" + "\n".join(f"• [{r[0]}] {r[1]}" for r in rows))
        except Exception:
            pass
    return "\n\n".join(out)


# ---------- Multi-Model Mid-Task Failover Chat with Backoff ----------
def chat(messages: List[Dict[str, Any]], requested_model: str, use_tools: bool = True) -> Dict[str, Any]:
    chain = build_provider_chain(requested_model)
    last_err = None
    for label, url, api_key, model_id in chain:
        payload = {"model": model_id, "messages": messages, "temperature": 0.2}
        if use_tools:
            payload["tools"] = TOOLS
        body = json.dumps(payload).encode("utf-8")
        headers = {
            "Content-Type": "application/json",
            "User-Agent": "ApexAgent-ClaudeCodeKiller/3.0",
        }
        if api_key:
            headers["Authorization"] = f"Bearer {api_key}"
        if "openrouter.ai" in url:
            headers["HTTP-Referer"] = "https://rjbusinesssolutions.org"
            headers["X-Title"] = "Apex Terminal OS"

        req = urllib.request.Request(url, data=body, headers=headers)

        # Retry loop for 429 rate limit backoff (up to 2 retries)
        for attempt in range(3):
            try:
                with urllib.request.urlopen(req, timeout=90) as r:
                    data = json.loads(r.read().decode("utf-8"))
                    return data["choices"][0]["message"]
            except urllib.error.HTTPError as e:
                last_err = f"{label} ({model_id}): HTTP {e.code} {e.reason}"
                if e.code == 429 and attempt < 2:
                    wait_time = (attempt + 1) * 2.0 + random.uniform(0.1, 0.5)
                    time.sleep(wait_time)
                    continue
                # If 402, 403, 400 or exhausted 429, break to next provider in failover chain
                break
            except Exception as e:
                last_err = f"{label} ({model_id}): {e}"
                break

    raise RuntimeError(f"All providers in failover chain failed. Last error: {last_err}")


# ---------- Parallel Tool Batch Execution ----------
def execute_tool_calls_in_parallel(
    tool_calls: List[Dict[str, Any]],
    trust: str,
    allow_cmds: List[str],
    parallel_concurrency: int = 8,
) -> List[Tuple[str, str]]:
    results: List[Tuple[str, str]] = []

    chunks: List[List[Dict[str, Any]]] = []
    current_chunk: List[Dict[str, Any]] = []
    current_is_readonly: bool = False

    for tc in tool_calls:
        fn_name = tc["function"]["name"]
        is_ro = fn_name in READ_ONLY_TOOLS
        if not current_chunk:
            current_chunk = [tc]
            current_is_readonly = is_ro
        elif is_ro == current_is_readonly and is_ro:
            current_chunk.append(tc)
        else:
            chunks.append(current_chunk)
            current_chunk = [tc]
            current_is_readonly = is_ro
    if current_chunk:
        chunks.append(current_chunk)

    for chunk in chunks:
        is_ro = chunk[0]["function"]["name"] in READ_ONLY_TOOLS
        if is_ro and len(chunk) > 1:
            print(f"\033[1;36m  ⚡ [PARALLEL BATCH: {len(chunk)} calls] Executing read/search operations concurrently...\033[0m")
            with concurrent.futures.ThreadPoolExecutor(max_workers=min(len(chunk), parallel_concurrency)) as pool:
                def _worker(item: Dict[str, Any]) -> Tuple[str, str]:
                    fn = item["function"]["name"]
                    raw_args = item["function"].get("arguments") or "{}"
                    a = json.loads(raw_args) if isinstance(raw_args, str) else raw_args
                    arg_prev = ", ".join(f"{k}={str(v)[:40]}" for k, v in a.items())
                    t0 = time.time()
                    res = execute_single_tool(fn, a, trust, allow_cmds)
                    dt = time.time() - t0
                    print(f"\033[0;34m    ↳ ⚡ {fn}({arg_prev}) [{dt*1000:.0f}ms]\033[0m")
                    return item["id"], res

                future_map = [pool.submit(_worker, c) for c in chunk]
                for fut in future_map:
                    cid, r_text = fut.result()
                    results.append((cid, r_text))
        else:
            for tc in chunk:
                fn = tc["function"]["name"]
                raw_args = tc["function"].get("arguments") or "{}"
                a = json.loads(raw_args) if isinstance(raw_args, str) else raw_args
                arg_prev = ", ".join(f"{k}={str(v)[:50]}" for k, v in a.items())
                print(f"\033[1;34m  🔧 {fn}({arg_prev})\033[0m")
                res = execute_single_tool(fn, a, trust, allow_cmds)
                results.append((tc["id"], res))

    return results


# ---------- Main CLI Entrypoint ----------
def main() -> None:
    args = sys.argv[1:]
    trust = "ask"
    plan = False
    swarm = False
    model = os.environ.get("VENICE_MODEL", "zai-org-glm-5-2")
    max_steps = 40
    parallel_concurrency = 8
    allow_cmds: List[str] = ["git status", "git diff", "ls", "pwd", "pytest", "vitest", "npm test", "rg"]

    while args and args[0].startswith("--"):
        flag = args.pop(0)
        if flag in ("-h", "--help"):
            print(__doc__)
            sys.exit(0)
        elif flag == "--plan":
            plan = True
        elif flag == "--swarm":
            swarm = True
        elif flag == "--trust" and args:
            trust = args.pop(0)
        elif flag == "--model" and args:
            model = args.pop(0)
        elif flag == "--parallel" and args:
            parallel_concurrency = int(args.pop(0))
        elif flag == "--max-steps" and args:
            max_steps = int(args.pop(0))

    task = " ".join(args).strip()
    if not task:
        print(__doc__)
        sys.exit(1)

    if os.path.isfile(".apexagent"):
        try:
            cfg = json.loads(pathlib.Path(".apexagent").read_text(encoding="utf-8"))
            trust = cfg.get("trust", trust)
            model = cfg.get("model", model)
            max_steps = int(cfg.get("max_steps", max_steps))
            parallel_concurrency = int(cfg.get("parallel", parallel_concurrency))
            allow_cmds.extend(cfg.get("allow_cmds", []))
        except Exception:
            pass

    ctx = context_files()
    sysm = (
        "You are apex-agent v3.0, the sovereign agentic engineering loop of Apex Terminal OS. "
        "You operate directly in macOS shell with native parallel tool execution. "
        "Available tools:\n"
        "- read_file, write_file, edit_file: surgical file inspection and manipulation\n"
        "- run_shell: execute build, test, and shell commands\n"
        "- grep_code: ripgrep-accelerated symbol and regex search\n"
        "- find_files: fast glob pattern file search\n"
        "- list_dir: noise-filtered directory tree inspection\n"
        "- git_diff_patch: inspect unstaged and staged changes\n"
        "- fetch_web: fetch online documentation, API schemas, and GitHub resources\n"
        "- run_applescript: macOS native GUI, application, and notification automation\n"
        "- spawn_parallel_workers: spawn concurrent subagents for independent parallel tasks\n"
        "- remember_insight, semantic_search_memory: persistent cross-session SQLite memory\n"
        "- search_contacts: search macOS address book by name for contacts and phone numbers\n"
        "- send_sms: dispatch SMS / iMessage texts to contacts or phone numbers from Rick's iPhone 14 number (+1 945-308-8003) via macOS Messages.app\n\n"
        "EXECUTION DISCIPLINE:\n"
        "1. For multi-file inspection or searches, issue multiple tool calls in a single turn — they will execute in parallel concurrently!\n"
        "2. When editing code, ALWAYS run verification tests via run_shell before declaring completion.\n"
        "3. If a test or command fails, analyze the error output, fix the root cause, and re-verify.\n"
        "4. Be concise, precise, and deliver working verified results."
        + (f"\n\nProject & Persistent Memory Context:\n{ctx}" if ctx else "")
    )
    if swarm:
        task = f"Decompose this task into independent parallel subtasks and use spawn_parallel_workers to execute them concurrently: {task}"

    messages = [{"role": "system", "content": sysm}, {"role": "user", "content": task}]

    git = subprocess.run("git rev-parse --abbrev-ref HEAD", shell=True, capture_output=True, text=True)
    branch_info = f" · branch {git.stdout.strip()}" if git.returncode == 0 else ""
    print(
        f"\033[1;35m⚔️  apex-agent v3.0 · model={model} · trust={trust} · parallel={parallel_concurrency}{branch_info}\033[0m"
    )

    if plan:
        plan_msgs = [
            {"role": "system", "content": sysm},
            {
                "role": "user",
                "content": (
                    "PLAN ONLY — do not edit any files yet. Produce a concise numbered execution plan "
                    f"listing exact files to touch, parallel steps, and verification commands to run. Task: {task}"
                ),
            },
        ]
        plan_resp = chat(plan_msgs, model, use_tools=False)
        plan_text = plan_resp.get("content", "")
        print(f"\n\033[1;36m📋 EXECUTION PLAN:\033[0m\n{plan_text}\n")
        if trust != "yolo":
            if input("\033[1;33mExecute this plan now? [y/N] > \033[0m").strip().lower() != "y":
                sys.exit(0)
        messages.append({"role": "assistant", "content": f"Approved Execution Plan:\n{plan_text}"})
        messages.append({"role": "user", "content": "Proceed to execute the approved plan using your tools and verify."})

    for step in range(1, max_steps + 1):
        msg = chat(messages, model, use_tools=True)
        messages.append(msg)
        tool_calls = msg.get("tool_calls") or []
        if tool_calls:
            print(f"\033[1;33m[Step {step}/{max_steps}] Processing {len(tool_calls)} tool call(s)...\033[0m")
            results = execute_tool_calls_in_parallel(tool_calls, trust, allow_cmds, parallel_concurrency)
            for cid, r_text in results:
                messages.append({"role": "tool", "tool_call_id": cid, "content": r_text[:8000]})
        else:
            print(f"\n\033[1;32m✓ {msg.get('content') or '(Task Completed)'}\033[0m")
            sys.exit(0)

    print(f"\033[1;31m✗ Step budget exhausted ({max_steps}) — refine the task or pass --max-steps 80\033[0m")


if __name__ == "__main__":
    main()
